---
import { Image } from "emdash/ui";

interface Props {
	recipe: any;
}

const { recipe } = Astro.props;
const data = recipe.data;
---

<article class="recipe-card" data-source={data.recipe_source || ""} data-equipment={data.equipment || ""} data-title={data.title || ""}>
	<a href={`/recipes/${recipe.id}`} class="card-link">
		{data.featured_image && (
			<div class="card-image">
				<Image image={data.featured_image} alt={data.title} />
				{data.recipe_source && (
					<span class="source-badge">
						{data.recipe_source}
					</span>
				)}
			</div>
		)}

		<div class="card-body">
			{data.equipment && (
				<div class="equipment-pill">
					⚙️ {data.equipment}
				</div>
			)}

			<div class="card-meta">
				{data.prep_time && <span class="meta-item">Prep: {data.prep_time}</span>}
				{data.cook_time && <span class="meta-item">Cook: {data.cook_time}</span>}
				{data.servings && <span class="meta-badge">{data.servings}</span>}
			</div>

			<h3 class="card-title">{data.title}</h3>
			{data.excerpt && <p class="card-excerpt">{data.excerpt}</p>}
		</div>
	</a>
</article>

<style>
	.recipe-card {
		background: var(--color-surface, #ffffff);
		border: 1px solid var(--color-border, #e2e8f0);
		border-radius: 12px;
		overflow: hidden;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}
	.recipe-card:hover {
		transform: translateY(-3px);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
	}
	.card-link {
		text-decoration: none;
		color: inherit;
		display: flex;
		flex-direction: column;
		height: 100%;
	}
	.card-image {
		aspect-ratio: 16 / 10;
		overflow: hidden;
		background: var(--color-bg-subtle, #f1f5f9);
		position: relative;
	}
	.card-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.3s ease;
	}
	.source-badge {
		position: absolute;
		top: 0.75rem;
		right: 0.75rem;
		background: rgba(15, 23, 42, 0.85);
		backdrop-filter: blur(4px);
		color: #ffffff;
		font-weight: 700;
		font-size: 0.6875rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		padding: 0.25rem 0.6rem;
		border-radius: 20px;
	}
	.recipe-card:hover .card-image img {
		transform: scale(1.03);
	}
	.card-body {
		padding: 1.25rem;
		display: flex;
		flex-direction: column;
		flex-grow: 1;
	}
	.equipment-pill {
		font-size: 0.75rem;
		font-weight: 600;
		color: #d97706;
		margin-bottom: 0.35rem;
	}
	.card-meta {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-size: 0.8125rem;
		color: var(--color-muted, #64748b);
		margin-bottom: 0.5rem;
		flex-wrap: wrap;
	}
	.meta-badge {
		background: rgba(0, 102, 204, 0.1);
		color: var(--color-brand, #0066cc);
		font-weight: 600;
		padding: 0.15rem 0.5rem;
		border-radius: 4px;
		font-size: 0.75rem;
	}
	.card-title {
		font-size: 1.25rem;
		font-weight: 600;
		margin: 0 0 0.5rem 0;
		color: var(--color-text, #0f172a);
		line-height: 1.3;
	}
	.recipe-card:hover .card-title {
		color: var(--color-brand, #0066cc);
	}
	.card-excerpt {
		font-size: 0.9375rem;
		color: var(--color-text-secondary, #475569);
		margin: 0;
		line-height: 1.5;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
</style>
