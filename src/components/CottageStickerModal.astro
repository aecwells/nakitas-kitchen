---
interface Props {
	title: string;
	slug: string;
	netWeight?: string;
	ingredientsText?: string;
	allergens?: string;
	cottageLicenseNumber?: string;
	price?: string;
}

const {
	title,
	slug,
	netWeight = "12 oz (340g)",
	ingredientsText = "Organic Flour, Butter, Cane Sugar, Natural Flavors, Sea Salt.",
	allergens = "Contains: Wheat, Dairy.",
	cottageLicenseNumber = "CFO-LA-2026-9481",
	price = "14.00",
} = Astro.props;

const productUrl = `https://nakitas-kitchen.nakitas-kitchen.workers.dev/shop/${slug}`;
const qrApiUrl = `https://api.qrserver.com/v1/create-qr-code/?size=160x160&data=${encodeURIComponent(productUrl)}`;
---

<div id="sticker-modal-overlay" class="sticker-modal-overlay" hidden>
	<div class="sticker-modal-backdrop" id="sticker-modal-backdrop"></div>
	
	<div class="sticker-modal-card">
		<div class="modal-header no-print">
			<div class="modal-title-row">
				<span class="modal-icon">🏷️</span>
				<div>
					<h3>Cottage Bakery Product Label Generator</h3>
					<p class="modal-subtitle">California Statutory Compliant 3" x 4" Packaging Sticker</p>
				</div>
			</div>
			<button type="button" id="close-sticker-modal" class="close-modal-btn" aria-label="Close modal">✕</button>
		</div>

		<div class="modal-body">
			<!-- Printable Sticker Label Frame -->
			<div class="cottage-sticker-frame" id="printable-sticker">
				<div class="sticker-top-brand">
					<div class="sticker-logo-wrap">
						<img src="/logo.jpg" alt="Nakita's Kitchen Logo" class="sticker-dog-img" />
					</div>
					<div class="sticker-brand-text">
						<h2 class="sticker-bakery-title">NAKITA'S KITCHEN</h2>
						<span class="sticker-license">Cottage Food License #{cottageLicenseNumber}</span>
					</div>
				</div>

				<div class="sticker-divider"></div>

				<div class="sticker-product-header">
					<h1 class="sticker-product-name">{title}</h1>
					<div class="sticker-meta-row">
						<span class="sticker-weight">NET WT: {netWeight}</span>
						{price && <span class="sticker-price">${price}</span>}
					</div>
				</div>

				<div class="sticker-divider"></div>

				<div class="sticker-ingredients-box">
					<span class="section-heading">INGREDIENTS IN DESCENDING ORDER:</span>
					<p class="ingredients-list-text">{ingredientsText}</p>
				</div>

				{allergens && (
					<div class="sticker-allergen-box">
						<strong>ALLERGEN WARNING:</strong> {allergens}
					</div>
				)}

				<div class="sticker-statutory-notice">
					"MADE IN A HOME KITCHEN THAT HAS NOT BEEN INSPECTED BY THE DEPARTMENT OF STATE OR LOCAL HEALTH SERVICES."
				</div>

				<div class="sticker-footer-grid">
					<div class="qr-code-col">
						<img src={qrApiUrl} alt="Product QR Code" class="qr-code-img" />
						<span class="qr-caption">Scan for Recipe & Reviews 📱</span>
					</div>
					<div class="bakery-address-col">
						<span class="bakery-name">Nakita's Kitchen Bakery</span>
						<span class="bakery-loc">Los Angeles, CA 90024</span>
						<span class="bakery-batch">Batch #: {new Date().toISOString().slice(0, 10).replace(/-/g, "")}</span>
					</div>
				</div>
			</div>
		</div>

		<div class="modal-actions no-print">
			<button type="button" id="print-single-btn" class="print-btn primary-print">
				<span>🖨️ Print Single Label (3" x 4")</span>
			</button>
			<button type="button" id="print-sheet-btn" class="print-btn secondary-print">
				<span>📑 Print 6-Label Sheet</span>
			</button>
		</div>
	</div>
</div>

<style>
	.sticker-modal-overlay {
		position: fixed;
		inset: 0;
		z-index: 2100;
		display: none;
		align-items: center;
		justify-content: center;
		padding: 1.5rem;
	}

	.sticker-modal-overlay.is-open {
		display: flex !important;
	}

	.sticker-modal-overlay[hidden] {
		display: none !important;
	}

	.sticker-modal-backdrop {
		position: fixed;
		inset: 0;
		background: rgba(15, 23, 42, 0.7);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
	}

	.sticker-modal-card {
		position: relative;
		z-index: 2110;
		width: 100%;
		max-width: 520px;
		max-height: 90vh;
		background: var(--color-surface, #ffffff);
		border: 1px solid var(--color-border, #cbd5e1);
		border-radius: 16px;
		box-shadow: 0 25px 60px rgba(0, 0, 0, 0.3);
		display: flex;
		flex-direction: column;
		overflow: hidden;
	}

	.modal-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 1.25rem 1.5rem;
		background: var(--color-bg-subtle, #f8fafc);
		border-bottom: 1px solid var(--color-border, #e2e8f0);
	}

	.modal-title-row {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.modal-icon {
		font-size: 1.5rem;
	}

	.modal-title-row h3 {
		font-size: 1.1rem;
		font-weight: 700;
		margin: 0;
		color: var(--color-text, #0f172a);
	}

	.modal-subtitle {
		font-size: 0.75rem;
		color: var(--color-muted, #64748b);
		margin: 0;
	}

	.close-modal-btn {
		background: var(--color-surface, #ffffff);
		border: 1px solid var(--color-border, #cbd5e1);
		color: var(--color-text, #0f172a);
		width: 32px;
		height: 32px;
		border-radius: 50%;
		cursor: pointer;
		font-weight: 700;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: all 0.15s ease;
	}
	.close-modal-btn:hover {
		background: #ef4444;
		color: #ffffff;
		border-color: #ef4444;
	}

	.modal-body {
		padding: 1.5rem;
		overflow-y: auto;
		display: flex;
		justify-content: center;
		background: var(--color-bg, #f1f5f9);
	}

	/* Physical Printable Sticker Frame Styling */
	.cottage-sticker-frame {
		width: 360px;
		min-height: 480px;
		background: #ffffff;
		border: 2px solid #0f172a;
		border-radius: 12px;
		padding: 1rem;
		color: #0f172a;
		font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
		display: flex;
		flex-direction: column;
		justify-content: space-between;
	}

	.sticker-top-brand {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.sticker-logo-wrap {
		width: 44px;
		height: 44px;
		border-radius: 50%;
		border: 1.5px solid #0f172a;
		padding: 1px;
		flex-shrink: 0;
	}

	.sticker-dog-img {
		width: 100%;
		height: 100%;
		border-radius: 50%;
		object-fit: cover;
	}

	.sticker-brand-text {
		display: flex;
		flex-direction: column;
	}

	.sticker-bakery-title {
		font-family: Georgia, serif;
		font-size: 1.15rem;
		font-weight: 800;
		letter-spacing: -0.01em;
		margin: 0;
		color: #0f172a;
		line-height: 1.1;
	}

	.sticker-license {
		font-size: 0.6875rem;
		font-weight: 700;
		text-transform: uppercase;
		color: #475569;
		letter-spacing: 0.05em;
	}

	.sticker-divider {
		height: 1.5px;
		background: #0f172a;
		margin: 0.6rem 0;
	}

	.sticker-product-name {
		font-size: 1.25rem;
		font-weight: 800;
		margin: 0 0 0.3rem 0;
		color: #0f172a;
		line-height: 1.2;
		text-transform: uppercase;
	}

	.sticker-meta-row {
		display: flex;
		justify-content: space-between;
		font-size: 0.8125rem;
		font-weight: 700;
		color: #334155;
	}

	.sticker-price {
		background: #0f172a;
		color: #ffffff;
		padding: 0.1rem 0.5rem;
		border-radius: 4px;
	}

	.sticker-ingredients-box {
		margin: 0.4rem 0;
	}

	.section-heading {
		font-size: 0.625rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: #475569;
		display: block;
		margin-bottom: 0.2rem;
	}

	.ingredients-list-text {
		font-size: 0.75rem;
		line-height: 1.35;
		margin: 0;
		color: #1e293b;
		white-space: pre-wrap;
	}

	.sticker-allergen-box {
		background: #fef3c7;
		border: 1px solid #f59e0b;
		color: #92400e;
		font-size: 0.6875rem;
		font-weight: 700;
		padding: 0.35rem 0.5rem;
		border-radius: 4px;
		margin: 0.4rem 0;
	}

	.sticker-statutory-notice {
		font-size: 0.625rem;
		font-weight: 700;
		text-transform: uppercase;
		text-align: center;
		line-height: 1.25;
		color: #0f172a;
		border: 1px solid #0f172a;
		padding: 0.35rem 0.4rem;
		border-radius: 4px;
		margin: 0.4rem 0;
	}

	.sticker-footer-grid {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		padding-top: 0.4rem;
		border-top: 1px dashed #cbd5e1;
	}

	.qr-code-col {
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.qr-code-img {
		width: 60px;
		height: 60px;
		border: 1px solid #0f172a;
		border-radius: 4px;
	}

	.qr-caption {
		font-size: 0.5625rem;
		font-weight: 700;
		color: #475569;
		margin-top: 0.2rem;
	}

	.bakery-address-col {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		text-align: right;
		font-size: 0.65rem;
		color: #475569;
		line-height: 1.3;
	}

	.bakery-name {
		font-weight: 700;
		color: #0f172a;
	}

	.bakery-batch {
		font-family: monospace;
		font-size: 0.5625rem;
		color: #64748b;
	}

	.modal-actions {
		display: flex;
		gap: 0.75rem;
		padding: 1.25rem 1.5rem;
		background: var(--color-surface, #ffffff);
		border-top: 1px solid var(--color-border, #e2e8f0);
	}

	.print-btn {
		flex: 1;
		padding: 0.75rem 1rem;
		border-radius: 8px;
		font-weight: 700;
		font-size: 0.875rem;
		cursor: pointer;
		transition: all 0.15s ease;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.primary-print {
		background: var(--color-brand, #0066cc);
		color: #ffffff;
		border: none;
	}

	.primary-print:hover {
		background: var(--color-brand-hover, #004499);
	}

	.secondary-print {
		background: var(--color-bg-subtle, #f1f5f9);
		color: var(--color-text, #0f172a);
		border: 1px solid var(--color-border, #cbd5e1);
	}

	.secondary-print:hover {
		background: var(--color-border, #cbd5e1);
	}

	/* High-Precision Physical Label Print CSS (@media print) */
	@media print {
		body * {
			visibility: hidden !important;
		}

		.no-print {
			display: none !important;
		}

		#printable-sticker, #printable-sticker * {
			visibility: visible !important;
		}

		#printable-sticker {
			position: fixed !important;
			left: 0 !important;
			top: 0 !important;
			width: 3.5in !important;
			height: 4.5in !important;
			margin: 0 !important;
			padding: 0.25in !important;
			border: 2px solid #000000 !important;
			box-shadow: none !important;
			background: #ffffff !important;
			color: #000000 !important;
			page-break-after: always;
		}
	}
</style>

<script>
	document.addEventListener("DOMContentLoaded", () => {
		const modal = document.getElementById("sticker-modal-overlay");
		const backdrop = document.getElementById("sticker-modal-backdrop");
		const closeBtn = document.getElementById("close-sticker-modal");
		const printSingleBtn = document.getElementById("print-single-btn");
		const printSheetBtn = document.getElementById("print-sheet-btn");

		function closeModal() {
			if (!modal) return;
			modal.classList.remove("is-open");
			modal.hidden = true;
			document.body.style.overflow = "";
		}

		closeBtn?.addEventListener("click", closeModal);
		backdrop?.addEventListener("click", closeModal);

		printSingleBtn?.addEventListener("click", () => {
			window.print();
		});

		printSheetBtn?.addEventListener("click", () => {
			window.print();
		});
	});
</script>
