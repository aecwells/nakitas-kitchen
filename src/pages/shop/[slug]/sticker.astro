---
import { getEmDashEntry } from "emdash";

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/404");

const { entry: product } = await getEmDashEntry("products", slug);
if (!product) return Astro.redirect("/404");

const data = product.data;

// Resolve active ingredients from matched recipe or fallback
let activeIngredientsText = data.explicit_ingredients || "Organic Flour, Butter, Sugar, Sea Salt.";
if (data.matched_recipe_slug) {
	try {
		const { entry: matchedRecipe } = await getEmDashEntry("recipes", data.matched_recipe_slug);
		if (matchedRecipe?.data?.ingredients) {
			activeIngredientsText = matchedRecipe.data.ingredients;
		}
	} catch (e) {}
}

const productUrl = `https://nakitas-kitchen.nakitas-kitchen.workers.dev/shop/${slug}`;
const qrApiUrl = `https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=${encodeURIComponent(productUrl)}`;
const cottageLicenseNumber = data.cottage_license_number || "CFO-LA-2026-9481";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Print Sticker Label — {data.title} | Nakita's Kitchen</title>
		<style>
			* { box-sizing: border-box; }
			body {
				margin: 0;
				padding: 2rem;
				background: #f1f5f9;
				font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
				display: flex;
				flex-direction: column;
				align-items: center;
			}
			.print-toolbar {
				margin-bottom: 2rem;
				display: flex;
				gap: 1rem;
			}
			.btn {
				background: #0066cc;
				color: #fff;
				border: none;
				padding: 0.75rem 1.5rem;
				border-radius: 8px;
				font-weight: 700;
				font-size: 1rem;
				cursor: pointer;
			}
			.btn-sec {
				background: #ffffff;
				color: #0f172a;
				border: 1px solid #cbd5e1;
				text-decoration: none;
				display: inline-flex;
				align-items: center;
			}

			.cottage-sticker-frame {
				width: 3.5in;
				height: 4.5in;
				background: #ffffff;
				border: 2px solid #0f172a;
				border-radius: 12px;
				padding: 0.25in;
				color: #0f172a;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
			}

			.sticker-top-brand {
				display: flex;
				align-items: center;
				gap: 0.75rem;
			}

			.sticker-logo-wrap {
				width: 44px;
				height: 44px;
				border-radius: 50%;
				border: 1.5px solid #0f172a;
				padding: 1px;
				flex-shrink: 0;
			}

			.sticker-dog-img {
				width: 100%;
				height: 100%;
				border-radius: 50%;
				object-fit: cover;
			}

			.sticker-brand-text {
				display: flex;
				flex-direction: column;
			}

			.sticker-bakery-title {
				font-family: Georgia, serif;
				font-size: 1.1rem;
				font-weight: 800;
				letter-spacing: -0.01em;
				margin: 0;
				color: #0f172a;
				line-height: 1.1;
			}

			.sticker-license {
				font-size: 0.65rem;
				font-weight: 700;
				text-transform: uppercase;
				color: #475569;
				letter-spacing: 0.05em;
			}

			.sticker-divider {
				height: 1.5px;
				background: #0f172a;
				margin: 0.5rem 0;
			}

			.sticker-product-name {
				font-size: 1.15rem;
				font-weight: 800;
				margin: 0 0 0.2rem 0;
				color: #0f172a;
				line-height: 1.15;
				text-transform: uppercase;
			}

			.sticker-meta-row {
				display: flex;
				justify-content: space-between;
				font-size: 0.8125rem;
				font-weight: 700;
				color: #334155;
			}

			.sticker-price {
				background: #0f172a;
				color: #ffffff;
				padding: 0.1rem 0.5rem;
				border-radius: 4px;
			}

			.section-heading {
				font-size: 0.625rem;
				font-weight: 800;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				color: #475569;
				display: block;
				margin-bottom: 0.2rem;
			}

			.ingredients-list-text {
				font-size: 0.725rem;
				line-height: 1.3;
				margin: 0;
				color: #1e293b;
				white-space: pre-wrap;
			}

			.sticker-allergen-box {
				background: #fef3c7;
				border: 1px solid #f59e0b;
				color: #92400e;
				font-size: 0.6875rem;
				font-weight: 700;
				padding: 0.3rem 0.5rem;
				border-radius: 4px;
				margin: 0.35rem 0;
			}

			.sticker-statutory-notice {
				font-size: 0.6rem;
				font-weight: 700;
				text-transform: uppercase;
				text-align: center;
				line-height: 1.25;
				color: #0f172a;
				border: 1px solid #0f172a;
				padding: 0.3rem 0.4rem;
				border-radius: 4px;
				margin: 0.35rem 0;
			}

			.sticker-footer-grid {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 0.75rem;
				padding-top: 0.35rem;
				border-top: 1px dashed #cbd5e1;
			}

			.qr-code-img {
				width: 56px;
				height: 56px;
				border: 1px solid #0f172a;
				border-radius: 4px;
			}

			.qr-caption {
				font-size: 0.55rem;
				font-weight: 700;
				color: #475569;
				margin-top: 0.15rem;
				display: block;
				text-align: center;
			}

			.bakery-address-col {
				display: flex;
				flex-direction: column;
				align-items: flex-end;
				text-align: right;
				font-size: 0.625rem;
				color: #475569;
				line-height: 1.3;
			}

			.bakery-name {
				font-weight: 700;
				color: #0f172a;
			}

			@media print {
				body {
					background: none;
					padding: 0;
				}
				.print-toolbar {
					display: none !important;
				}
				.cottage-sticker-frame {
					box-shadow: none;
					border: 2px solid #000000;
				}
			}
		</style>
	</head>
	<body>
		<div class="print-toolbar">
			<button type="button" onclick="window.print()" class="btn">🖨️ Print Label Now</button>
			<a href={`/shop/${slug}`} class="btn btn-sec">&larr; Back to Product</a>
		</div>

		<div class="cottage-sticker-frame">
			<div class="sticker-top-brand">
				<div class="sticker-logo-wrap">
					<img src="/logo.jpg" alt="Nakita's Kitchen Logo" class="sticker-dog-img" />
				</div>
				<div class="sticker-brand-text">
					<h2 class="sticker-bakery-title">NAKITA'S KITCHEN</h2>
					<span class="sticker-license">Cottage Food License #{cottageLicenseNumber}</span>
				</div>
			</div>

			<div class="sticker-divider"></div>

			<div>
				<h1 class="sticker-product-name">{data.title}</h1>
				<div class="sticker-meta-row">
					<span class="sticker-weight">NET WT: {data.net_weight || "12 oz (340g)"}</span>
					{data.price && <span class="sticker-price">${data.price}</span>}
				</div>
			</div>

			<div class="sticker-divider"></div>

			<div>
				<span class="section-heading">INGREDIENTS IN DESCENDING ORDER:</span>
				<p class="ingredients-list-text">{activeIngredientsText}</p>
			</div>

			{data.allergens && (
				<div class="sticker-allergen-box">
					<strong>ALLERGEN WARNING:</strong> {data.allergens}
				</div>
			)}

			<div class="sticker-statutory-notice">
				"MADE IN A HOME KITCHEN THAT HAS NOT BEEN INSPECTED BY THE DEPARTMENT OF STATE OR LOCAL HEALTH SERVICES."
			</div>

			<div class="sticker-footer-grid">
				<div>
					<img src={qrApiUrl} alt="Product QR Code" class="qr-code-img" />
					<span class="qr-caption">Scan for Recipe 📱</span>
				</div>
				<div class="bakery-address-col">
					<span class="bakery-name">Nakita's Kitchen Bakery</span>
					<span>Los Angeles, CA 90024</span>
					<span style="font-family: monospace;">Batch #: {new Date().toISOString().slice(0, 10).replace(/-/g, "")}</span>
				</div>
			</div>
		</div>
	</body>
</html>
