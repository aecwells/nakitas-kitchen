---
import { getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";
import ProductCard from "../../components/ProductCard.astro";

const { entries: products, cacheHint } = await getEmDashCollection("products", {
	orderBy: { createdAt: "desc" },
});

Astro.cache.set(cacheHint);
---

<Base title="Cottage Bakery Shop | Nakita's Kitchen" description="Pre-order fresh artisanal sourdough, brioche knots, and shortbread baked under Cottage Food License #CFO-LA-2026-9481.">
	<div class="container main-content">
		<header class="page-header">
			<div class="header-badge">Cottage Food Bakery</div>
			<h1 class="page-title">Weekly Bake Pre-Orders</h1>
			<p class="page-description">
				All items are freshly baked in small batches under Cottage License #CFO-LA-2026-9481 using organic flours and wholesome ingredients. Pre-order by Thursday for Saturday morning pickup.
			</p>
		</header>

		<!-- Interactive Product Category Filter Chips -->
		<div class="filter-bar">
			<span class="filter-label">Filter Bakery Category:</span>
			<div class="chips-row">
				<button type="button" class="shop-filter-chip active" data-filter="all">All Bakery Items</button>
				<button type="button" class="shop-filter-chip" data-filter="sourdough">🍞 Artisanal Sourdough</button>
				<button type="button" class="shop-filter-chip" data-filter="pastry">🥐 Pastries & Knots</button>
				<button type="button" class="shop-filter-chip" data-filter="cookies">🍪 Shortbread & Cookies</button>
			</div>
		</div>

		{products && products.length > 0 ? (
			<div class="products-grid" id="products-grid">
				{products.map((product) => (
					<ProductCard product={product} />
				))}
			</div>
		) : (
			<div class="empty-state">
				<p>No products currently available for pre-order. Check back soon!</p>
			</div>
		)}

		<section class="cottage-info-banner">
			<h3>Cottage Food Operation Information</h3>
			<p>
				Food items sold through Nakita's Kitchen are produced under Cottage Food License #CFO-LA-2026-9481. Every item clearly lists all ingredients in descending order of predominance and highlights common food allergens for full consumer safety and regulatory compliance.
			</p>
		</section>
	</div>
</Base>

<script>
	document.addEventListener("DOMContentLoaded", () => {
		const chips = document.querySelectorAll(".shop-filter-chip");
		const cards = document.querySelectorAll(".product-card");

		chips.forEach((chip) => {
			chip.addEventListener("click", () => {
				chips.forEach((c) => c.classList.remove("active"));
				chip.classList.add("active");

				const filter = chip.getAttribute("data-filter");
				cards.forEach((card) => {
					const el = card as HTMLElement;
					const title = (el.getAttribute("data-title") || "").toLowerCase();

					if (filter === "all") {
						el.style.display = "";
					} else if (filter === "sourdough" && (title.includes("sourdough") || title.includes("loaf") || title.includes("boule"))) {
						el.style.display = "";
					} else if (filter === "pastry" && (title.includes("knot") || title.includes("brioche") || title.includes("cinnamon") || title.includes("pastry"))) {
						el.style.display = "";
					} else if (filter === "cookies" && (title.includes("shortbread") || title.includes("cookie") || title.includes("box"))) {
						el.style.display = "";
					} else {
						el.style.display = "none";
					}
				});
			});
		});
	});
</script>

<style>
	.main-content {
		max-width: 1200px;
		margin: 0 auto;
		padding: 3rem 1.5rem;
	}
	.page-header {
		text-align: center;
		max-width: 720px;
		margin: 0 auto 2rem auto;
	}
	.header-badge {
		background: #22c55e;
		color: #ffffff;
		font-weight: 700;
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		padding: 0.35rem 0.85rem;
		border-radius: 20px;
		display: inline-block;
		margin-bottom: 0.75rem;
	}
	.page-title {
		font-size: 2.75rem;
		font-weight: 700;
		color: var(--color-text, #0f172a);
		margin: 0 0 1rem 0;
		letter-spacing: -0.02em;
	}
	.page-description {
		font-size: 1.125rem;
		color: var(--color-text-secondary, #475569);
		line-height: 1.6;
		margin: 0;
	}
	.filter-bar {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 2.5rem;
	}
	.filter-label {
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--color-muted, #64748b);
	}
	.chips-row {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
		justify-content: center;
	}
	.shop-filter-chip {
		background: var(--color-bg-subtle, #f1f5f9);
		border: 1px solid var(--color-border, #cbd5e1);
		color: var(--color-text, #0f172a);
		padding: 0.4rem 0.9rem;
		border-radius: 20px;
		font-size: 0.85rem;
		font-weight: 600;
		cursor: pointer;
		transition: all 0.15s ease;
	}
	.shop-filter-chip:hover {
		border-color: var(--color-brand, #0066cc);
		color: var(--color-brand, #0066cc);
	}
	.shop-filter-chip.active {
		background: var(--color-brand, #0066cc);
		color: #ffffff;
		border-color: var(--color-brand, #0066cc);
	}
	.products-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
		gap: 2rem;
		margin-bottom: 4rem;
	}
	.empty-state {
		text-align: center;
		padding: 4rem 1rem;
		color: var(--color-muted, #64748b);
	}
	.cottage-info-banner {
		background: var(--color-bg-subtle, #f8fafc);
		border: 1px solid var(--color-border, #e2e8f0);
		border-radius: 16px;
		padding: 2rem;
		text-align: center;
		max-width: 800px;
		margin: 0 auto;
	}
	.cottage-info-banner h3 {
		font-size: 1.25rem;
		margin-bottom: 0.5rem;
		color: var(--color-text, #0f172a);
	}
	.cottage-info-banner p {
		font-size: 0.9375rem;
		color: var(--color-text-secondary, #475569);
		margin: 0;
		line-height: 1.6;
	}
</style>
