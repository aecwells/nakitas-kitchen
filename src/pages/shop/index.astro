---
import { getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";
import ProductCard from "../../components/ProductCard.astro";

const { entries: products, cacheHint } = await getEmDashCollection("products", {
	orderBy: { createdAt: "desc" },
});

Astro.cache.set(cacheHint);
---

<Base title="Cottage Bakery Shop | Nakita's Kitchen" description="Pre-order fresh artisanal sourdough, brioche knots, and shortbread baked under Cottage Food License #CFO-LA-2026-9481.">
	<div class="container main-page-wrapper">
		<header class="page-header">
			<div class="header-badge">Cottage Food Bakery</div>
			<h1 class="page-title">Weekly Bake Pre-Orders</h1>
			<p class="page-description">
				All items are freshly baked in small batches under Cottage License #CFO-LA-2026-9481 using organic flours and wholesome ingredients. Pre-order by Thursday for Saturday morning pickup.
			</p>
		</header>

		<!-- 2-Column Sidebar Widget Layout -->
		<div class="page-layout-container">
			<!-- LEFT SIDEBAR FILTER WIDGETS -->
			<aside class="sidebar-widgets-col">
				<div class="sidebar-widget">
					<h4 class="widget-title">🔍 Search Ingredients</h4>
					<div class="ingredient-search-box">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="search-icon">
							<circle cx="11" cy="11" r="8"></circle>
							<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
						</svg>
						<input
							type="text"
							id="shop-search-input"
							placeholder="Flour, Lemon, Cinnamon..."
							class="filter-text-input"
						/>
					</div>
				</div>

				<!-- Hierarchical Sub-Categories Widget -->
				<div class="sidebar-widget">
					<h4 class="widget-title">🍞 Bakery Sub-Categories</h4>
					<div class="category-tree">
						<button type="button" class="tree-btn active" data-cat="all">All Bakery Items</button>
						
						<div class="tree-group">
							<button type="button" class="tree-parent-btn" data-cat="breads">🍞 Breads & Sourdough</button>
							<div class="tree-sub-group">
								<button type="button" class="tree-sub-btn" data-cat="country-sourdough">↳ Country Sourdough</button>
								<button type="button" class="tree-sub-btn" data-cat="jalapeno-cheddar">↳ Jalapeño Cheddar</button>
							</div>
						</div>

						<div class="tree-group">
							<button type="button" class="tree-parent-btn" data-cat="pastries">🥐 Pastries & Sweets</button>
							<div class="tree-sub-group">
								<button type="button" class="tree-sub-btn" data-cat="cardamom-knots">↳ Cardamom Knots</button>
								<button type="button" class="tree-sub-btn" data-cat="shortbread-cookies">↳ Shortbread & Cookies</button>
							</div>
						</div>
					</div>
				</div>

				<!-- Ingredient Variation & Form Types Widget -->
				<div class="sidebar-widget">
					<h4 class="widget-title">🌿 Ingredient Form & Variations</h4>
					<div class="variation-chips">
						<span class="var-group-label">Flour Type:</span>
						<button type="button" class="var-chip" data-var="bread flour">Organic Bread Flour</button>
						<button type="button" class="var-chip" data-var="rye">Whole Rye</button>
						
						<span class="var-group-label">Spices & Citrus:</span>
						<button type="button" class="var-chip" data-var="meyer lemon">Meyer Lemon</button>
						<button type="button" class="var-chip" data-var="cinnamon">Ceylon Cinnamon</button>
						<button type="button" class="var-chip" data-var="cardamom">Cardamom</button>

						<span class="var-group-label">Dairy & Fat:</span>
						<button type="button" class="var-chip" data-var="irish butter">Irish Butter</button>
					</div>
				</div>

				<div class="sidebar-widget">
					<h4 class="widget-title">⚖️ Portion Size</h4>
					<select id="weight-filter-select" class="filter-select">
						<option value="all">All Portions</option>
						<option value="loaf">Full Loaf (24 oz / 680g)</option>
						<option value="pack">Pack / Knots (16 oz / 450g)</option>
						<option value="box">Bakery Box (12 oz / 340g)</option>
					</select>
				</div>

				<div class="sidebar-widget">
					<h4 class="widget-title">🚫 Allergen Safety</h4>
					<select id="allergen-filter-select" class="filter-select">
						<option value="all">All Ingredients</option>
						<option value="no-dairy">Dairy-Free (No Milk/Butter)</option>
						<option value="no-wheat">Wheat/Gluten-Free</option>
					</select>
				</div>

				<div class="sidebar-widget">
					<h4 class="widget-title">📦 Pre-Order Status</h4>
					<select id="stock-filter-select" class="filter-select">
						<option value="all">All Items</option>
						<option value="in-stock">Available Pre-Orders Only</option>
					</select>
				</div>
			</aside>

			<!-- RIGHT MAIN PRODUCTS GRID -->
			<main class="main-content-col">
				{products && products.length > 0 ? (
					<div class="products-grid" id="products-grid">
						{products.map((product) => (
							<ProductCard product={product} />
						))}
					</div>
				) : (
					<div class="empty-state">
						<p>No products currently available for pre-order. Check back soon!</p>
					</div>
				)}

				<section class="cottage-info-banner">
					<h3>Cottage Food Operation Information</h3>
					<p>
						Food items sold through Nakita's Kitchen are produced under Cottage Food License #CFO-LA-2026-9481. Every item clearly lists all ingredients in descending order of predominance and highlights common food allergens for full consumer safety and regulatory compliance.
					</p>
				</section>
			</main>
		</div>
	</div>
</Base>

<script>
	document.addEventListener("DOMContentLoaded", () => {
		const searchInput = document.getElementById("shop-search-input") as HTMLInputElement;
		const weightSelect = document.getElementById("weight-filter-select") as HTMLSelectElement;
		const allergenSelect = document.getElementById("allergen-filter-select") as HTMLSelectElement;
		const stockSelect = document.getElementById("stock-filter-select") as HTMLSelectElement;
		const treeBtns = document.querySelectorAll(".tree-btn, .tree-parent-btn, .tree-sub-btn");
		const varChips = document.querySelectorAll(".var-chip");
		const cards = document.querySelectorAll(".product-card");

		let activeCat = "all";
		let activeVar = "";

		function applyFilters() {
			const query = (searchInput?.value || "").toLowerCase().trim();
			const weightFilter = weightSelect?.value || "all";
			const allergenFilter = allergenSelect?.value || "all";
			const stockFilter = stockSelect?.value || "all";

			cards.forEach((card) => {
				const el = card as HTMLElement;
				const title = el.getAttribute("data-title") || "";
				const description = el.getAttribute("data-description") || "";
				const netweight = el.getAttribute("data-netweight") || "";
				const ingredients = el.getAttribute("data-ingredients") || "";
				const allergens = el.getAttribute("data-allergens") || "";
				const instock = el.getAttribute("data-instock") === "true";

				const matchesQuery = !query || title.includes(query) || description.includes(query) || ingredients.includes(query);

				// Category & Sub-Category Match
				let matchesCat = true;
				if (activeCat !== "all") {
					if (activeCat === "breads") matchesCat = title.includes("sourdough") || title.includes("loaf");
					else if (activeCat === "country-sourdough") matchesCat = title.includes("sourdough") || title.includes("country");
					else if (activeCat === "jalapeno-cheddar") matchesCat = title.includes("jalapeno") || title.includes("cheddar");
					else if (activeCat === "pastries") matchesCat = title.includes("knot") || title.includes("shortbread");
					else if (activeCat === "cardamom-knots") matchesCat = title.includes("cardamom") || title.includes("knot");
					else if (activeCat === "shortbread-cookies") matchesCat = title.includes("shortbread");
				}

				// Variation match
				const matchesVar = !activeVar || ingredients.includes(activeVar) || title.includes(activeVar);

				let matchesWeight = true;
				if (weightFilter === "loaf") matchesWeight = netweight.includes("24") || netweight.includes("680");
				else if (weightFilter === "pack") matchesWeight = netweight.includes("16") || netweight.includes("450");
				else if (weightFilter === "box") matchesWeight = netweight.includes("12") || netweight.includes("340");

				let matchesAllergen = true;
				if (allergenFilter === "no-dairy") {
					matchesAllergen = !allergens.includes("dairy") && !allergens.includes("milk") && !ingredients.includes("butter");
				} else if (allergenFilter === "no-wheat") {
					matchesAllergen = !allergens.includes("wheat") && !allergens.includes("gluten") && !ingredients.includes("flour");
				}

				const matchesStock = stockFilter === "all" || (stockFilter === "in-stock" && instock);

				if (matchesQuery && matchesCat && matchesVar && matchesWeight && matchesAllergen && matchesStock) {
					el.style.display = "";
				} else {
					el.style.display = "none";
				}
			});
		}

		searchInput?.addEventListener("input", applyFilters);
		weightSelect?.addEventListener("change", applyFilters);
		allergenSelect?.addEventListener("change", applyFilters);
		stockSelect?.addEventListener("change", applyFilters);

		treeBtns.forEach((btn) => {
			btn.addEventListener("click", () => {
				treeBtns.forEach((b) => b.classList.remove("active"));
				btn.classList.add("active");
				activeCat = btn.getAttribute("data-cat") || "all";
				applyFilters();
			});
		});

		varChips.forEach((chip) => {
			chip.addEventListener("click", () => {
				if (chip.classList.contains("active")) {
					chip.classList.remove("active");
					activeVar = "";
				} else {
					varChips.forEach((c) => c.classList.remove("active"));
					chip.classList.add("active");
					activeVar = chip.getAttribute("data-var") || "";
				}
				applyFilters();
			});
		});
	});
</script>

<style>
	.main-page-wrapper {
		max-width: 1280px;
		margin: 0 auto;
		padding: 2.5rem 1.5rem 4rem 1.5rem;
	}
	.page-header {
		text-align: center;
		max-width: 720px;
		margin: 0 auto 2.5rem auto;
	}
	.header-badge {
		background: #22c55e;
		color: #ffffff;
		font-weight: 700;
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		padding: 0.35rem 0.85rem;
		border-radius: 20px;
		display: inline-block;
		margin-bottom: 0.75rem;
	}
	.page-title {
		font-size: 2.75rem;
		font-weight: 700;
		color: var(--color-text, #0f172a);
		margin: 0 0 1rem 0;
		letter-spacing: -0.02em;
	}
	.page-description {
		font-size: 1.125rem;
		color: var(--color-text-secondary, #475569);
		line-height: 1.6;
		margin: 0;
	}

	/* 2-Column Sidebar Layout */
	.page-layout-container {
		display: grid;
		grid-template-columns: 280px 1fr;
		gap: 2.5rem;
		align-items: start;
	}

	.sidebar-widgets-col {
		position: sticky;
		top: 90px;
		max-height: calc(100vh - 110px);
		overflow-y: auto;
		overflow-x: hidden;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		background: var(--color-surface, #ffffff);
		border: 1px solid var(--color-border, #e2e8f0);
		border-radius: 16px;
		padding: 1.25rem;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
		box-sizing: border-box;
		scrollbar-width: thin;
	}

	.sidebar-widget {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--color-border-subtle, #f1f5f9);
		width: 100%;
		box-sizing: border-box;
	}

	.sidebar-widget:last-child {
		border-bottom: none;
		padding-bottom: 0;
	}

	.widget-title {
		font-size: 0.8125rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--color-text, #0f172a);
		margin: 0;
	}

	.ingredient-search-box {
		position: relative;
		width: 100%;
		box-sizing: border-box;
	}

	.search-icon {
		position: absolute;
		left: 0.75rem;
		top: 50%;
		transform: translateY(-50%);
		color: var(--color-muted, #94a3b8);
	}

	.filter-text-input {
		width: 100%;
		max-width: 100%;
		box-sizing: border-box;
		padding: 0.6rem 0.6rem 0.6rem 2.2rem;
		font-size: 0.85rem;
		border: 1px solid var(--color-border, #cbd5e1);
		border-radius: 8px;
		background: var(--color-bg, #f8fafc);
		color: var(--color-text, #0f172a);
	}

	.filter-text-input:focus {
		outline: none;
		border-color: var(--color-brand, #0066cc);
	}

	/* Category Tree Styling */
	.category-tree {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.tree-group {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}

	.tree-btn, .tree-parent-btn {
		text-align: left;
		background: var(--color-bg-subtle, #f8fafc);
		border: 1px solid var(--color-border, #e2e8f0);
		color: var(--color-text, #0f172a);
		padding: 0.45rem 0.75rem;
		border-radius: 8px;
		font-size: 0.85rem;
		font-weight: 700;
		cursor: pointer;
		transition: all 0.15s ease;
	}

	.tree-sub-group {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding-left: 0.85rem;
	}

	.tree-sub-btn {
		text-align: left;
		background: transparent;
		border: 1px solid transparent;
		color: var(--color-text-secondary, #475569);
		padding: 0.3rem 0.6rem;
		border-radius: 6px;
		font-size: 0.8rem;
		font-weight: 600;
		cursor: pointer;
		transition: all 0.15s ease;
	}

	.tree-sub-btn:hover {
		color: var(--color-brand, #0066cc);
		background: var(--color-bg-subtle, #f1f5f9);
	}

	.tree-btn.active, .tree-parent-btn.active, .tree-sub-btn.active {
		background: var(--color-brand, #0066cc);
		color: #ffffff;
		border-color: var(--color-brand, #0066cc);
	}

	/* Variation Chips Styling */
	.variation-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		align-items: center;
	}

	.var-group-label {
		width: 100%;
		font-size: 0.7rem;
		font-weight: 700;
		text-transform: uppercase;
		color: var(--color-muted, #64748b);
		margin-top: 0.35rem;
	}

	.var-chip {
		background: var(--color-bg-subtle, #f1f5f9);
		border: 1px solid var(--color-border, #cbd5e1);
		color: var(--color-text, #0f172a);
		padding: 0.25rem 0.55rem;
		border-radius: 12px;
		font-size: 0.75rem;
		font-weight: 600;
		cursor: pointer;
		transition: all 0.15s ease;
	}

	.var-chip:hover {
		border-color: var(--color-brand, #0066cc);
		color: var(--color-brand, #0066cc);
	}

	.var-chip.active {
		background: var(--color-brand, #0066cc);
		color: #ffffff;
		border-color: var(--color-brand, #0066cc);
	}

	.filter-select {
		width: 100%;
		padding: 0.55rem 0.65rem;
		font-size: 0.8125rem;
		font-weight: 600;
		border: 1px solid var(--color-border, #cbd5e1);
		border-radius: 8px;
		background: var(--color-bg, #f8fafc);
		color: var(--color-text, #0f172a);
		cursor: pointer;
	}

	.main-content-col {
		flex: 1;
	}

	.products-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 2rem;
		margin-bottom: 4rem;
	}

	.empty-state {
		text-align: center;
		padding: 4rem 1rem;
		color: var(--color-muted, #64748b);
	}

	.cottage-info-banner {
		background: var(--color-bg-subtle, #f8fafc);
		border: 1px solid var(--color-border, #e2e8f0);
		border-radius: 16px;
		padding: 2rem;
		text-align: center;
		margin-top: 2rem;
	}

	.cottage-info-banner h3 {
		font-size: 1.25rem;
		margin-bottom: 0.5rem;
		color: var(--color-text, #0f172a);
	}

	.cottage-info-banner p {
		font-size: 0.9375rem;
		color: var(--color-text-secondary, #475569);
		margin: 0;
		line-height: 1.6;
	}

	@media (max-width: 900px) {
		.page-layout-container {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.sidebar-widgets-col {
			position: static;
		}
	}
</style>
