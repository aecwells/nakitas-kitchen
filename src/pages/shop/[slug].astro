---
import { getEmDashEntry, getEntryTerms } from "emdash";
import { Image, Comments } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import CottageIngredientNotice from "../../components/CottageIngredientNotice.astro";
import CottageStickerModal from "../../components/CottageStickerModal.astro";

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/404");

const { entry: product, cacheHint } = await getEmDashEntry("products", slug);
if (!product) return Astro.redirect("/404");

Astro.cache.set(cacheHint);
const data = product.data;

// Retrieve taxonomy terms
const [categories, tags] = await Promise.all([
	getEntryTerms("products", data.id, "category").catch(() => []),
	getEntryTerms("products", data.id, "tag").catch(() => []),
]);

// Check if user is logged into EmDash Admin
const isLoggedIn = !!Astro.locals.user;

// Resolve active ingredients from matched recipe or fallback
let activeIngredientsText = data.explicit_ingredients || "Organic Flour, Butter, Sugar, Sea Salt.";
let matchedRecipeTitle = "";
if (data.matched_recipe_slug) {
	try {
		const { entry: matchedRecipe } = await getEmDashEntry("recipes", data.matched_recipe_slug);
		if (matchedRecipe?.data?.ingredients) {
			activeIngredientsText = matchedRecipe.data.ingredients;
			matchedRecipeTitle = matchedRecipe.data.title;
		}
	} catch (e) {}
}
---

<Base
	title={`${data.title} | Nakita's Kitchen Shop`}
	description={data.description || data.title}
	image={data.featured_image?.src}
	type="website"
	content={{ collection: "products", id: data.id, slug: product.id }}
>
	<div class="product-detail-page container">
		<div class="header-nav-row">
			<a href="/shop" class="back-link">&larr; Back to Cottage Bakery Shop</a>
			{categories && categories.length > 0 && (
				<div class="category-chips">
					{categories.map((cat: any) => (
						<span class="cat-chip">{cat.label}</span>
					))}
				</div>
			)}
		</div>

		<div class="product-grid">
			<!-- LEFT COLUMN: Product Visuals & Official Statutory Packaging Sticker -->
			<div class="product-gallery">
				{data.featured_image ? (
					<div class="image-wrapper">
						<Image image={data.featured_image} alt={data.title} />
					</div>
				) : (
					<div class="image-placeholder">No Image Available</div>
				)}

				{tags && tags.length > 0 && (
					<div class="product-tags">
						{tags.map((tag: any) => (
							<span class="tag-chip">#{tag.label}</span>
						))}
					</div>
				)}

				<!-- Official Cottage Bakery Packaging Sticker & Statutory Notice (Left Column) -->
				<CottageIngredientNotice
					productTitle={data.title}
					productSlug={product.id}
					netWeight={data.net_weight}
					price={data.price}
					matchedRecipeSlug={data.matched_recipe_slug}
					explicitIngredients={data.explicit_ingredients}
					allergens={data.allergens}
					cottageLicenseNumber={data.cottage_license_number}
					isLoggedIn={isLoggedIn}
				/>
			</div>

			<!-- RIGHT COLUMN: Product Commerce, Description, Checkout & Recipe Synergy -->
			<div class="product-info">
				<div class="product-header-badge">
					<span class="badge-cottage">Cottage Bakery Item</span>
					{data.net_weight && <span class="portion-badge">Portion: {data.net_weight}</span>}
				</div>

				<h1 class="product-title">{data.title}</h1>
				<div class="price-row">
					<span class="product-price">${data.price}</span>
				</div>

				{data.description && <p class="product-description">{data.description}</p>}

				<!-- Stripe Checkout Pre-Order Card -->
				<div class="checkout-card">
					<div class="stock-label">
						<span class="dot">●</span> {data.in_stock ? "Available for Saturday Pickup / Pre-Order" : "Currently Out of Stock"}
					</div>

					<button
						type="button"
						class="checkout-btn"
						disabled={!data.in_stock}
						data-stripe-price-id={data.stripe_price_id}
						onclick="alert('Stripe Checkout Connection: Pre-order registration for ' + this.getAttribute('data-stripe-price-id') + ' ready!')"
					>
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
							<line x1="3" y1="6" x2="21" y2="6"/>
							<path d="M16 10a4 4 0 0 1-8 0"/>
						</svg>
						<span>{data.in_stock ? `Pre-Order Now ($${data.price})` : "Sold Out"}</span>
					</button>

					<p class="pickup-note">
						📍 Pickup location: Local Porch / Saturday Farmers Market. Direct pre-order under Cottage License #CFO-LA-2026-9481.
					</p>
				</div>

				<!-- Recipe Synergy Card (Direct Link to Recipe Guide) -->
				{data.matched_recipe_slug && (
					<div class="recipe-synergy-card">
						<div class="synergy-header">
							<span class="synergy-icon">📖</span>
							<div>
								<h4 class="synergy-title">Artisan Recipe & Baking Story</h4>
								<p class="synergy-subtitle">See how we bake {matchedRecipeTitle || data.title}</p>
							</div>
						</div>
						<a href={`/recipes/${data.matched_recipe_slug}`} class="synergy-btn">
							<span>Read Step-by-Step Baking Guide &rarr;</span>
						</a>
					</div>
				)}
			</div>
		</div>

		<!-- Product Reviews & Customer Questions -->
		<section class="comments-section">
			<h3 class="comments-heading">Customer Reviews & Pre-Order Questions</h3>
			<Comments collection="products" contentId={data.id} threaded />
		</section>
	</div>

	<!-- Printable Cottage Sticker Modal (GATED TO ADMIN ONLY) -->
	{isLoggedIn && (
		<CottageStickerModal
			title={data.title}
			slug={product.id}
			netWeight={data.net_weight}
			ingredientsText={activeIngredientsText}
			allergens={data.allergens}
			cottageLicenseNumber={data.cottage_license_number}
			price={data.price}
		/>
	)}
</Base>

<script>
	document.addEventListener("DOMContentLoaded", () => {
		const openStickerBtn = document.getElementById("open-sticker-btn");
		const stickerModal = document.getElementById("sticker-modal-overlay");

		openStickerBtn?.addEventListener("click", () => {
			if (!stickerModal) return;
			stickerModal.classList.add("is-open");
			stickerModal.hidden = false;
			document.body.style.overflow = "hidden";
		});
	});
</script>

<style>
	.product-detail-page {
		max-width: 1180px;
		margin: 0 auto;
		padding: 2.5rem 1.5rem 4rem 1.5rem;
	}
	.header-nav-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 2rem;
	}
	.back-link {
		color: var(--color-brand, #0066cc);
		font-weight: 600;
		font-size: 0.9375rem;
		text-decoration: none;
	}
	.back-link:hover {
		text-decoration: underline;
	}
	.category-chips {
		display: flex;
		gap: 0.5rem;
	}
	.cat-chip {
		background: var(--color-bg-subtle, #f1f5f9);
		border: 1px solid var(--color-border, #cbd5e1);
		color: var(--color-brand, #0066cc);
		font-size: 0.75rem;
		font-weight: 600;
		padding: 0.2rem 0.6rem;
		border-radius: 12px;
	}
	.product-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3.5rem;
		margin-bottom: 4rem;
		align-items: start;
	}
	.product-gallery {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}
	.image-wrapper {
		border-radius: 16px;
		overflow: hidden;
		background: var(--color-bg-subtle, #f8fafc);
		border: 1px solid var(--color-border, #e2e8f0);
		aspect-ratio: 4 / 3;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
	}
	.image-wrapper img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.image-placeholder {
		aspect-ratio: 4 / 3;
		background: var(--color-bg-subtle, #f8fafc);
		border: 2px dashed var(--color-border, #cbd5e1);
		border-radius: 16px;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--color-muted, #94a3b8);
	}
	.product-tags {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
	}
	.tag-chip {
		font-size: 0.8125rem;
		color: var(--color-muted, #64748b);
		background: var(--color-bg-subtle, #f1f5f9);
		padding: 0.25rem 0.65rem;
		border-radius: 8px;
		font-weight: 600;
	}
	.product-header-badge {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 0.75rem;
	}
	.badge-cottage {
		background: #22c55e;
		color: #ffffff;
		font-weight: 700;
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		padding: 0.3rem 0.75rem;
		border-radius: 20px;
	}
	.portion-badge {
		font-size: 0.8125rem;
		color: var(--color-text-secondary, #64748b);
		font-weight: 600;
	}
	.product-title {
		font-size: 2.35rem;
		font-weight: 800;
		color: var(--color-text, #0f172a);
		margin: 0 0 0.5rem 0;
		line-height: 1.2;
		letter-spacing: -0.02em;
	}
	.price-row {
		display: flex;
		align-items: baseline;
		gap: 1rem;
		margin-bottom: 1.25rem;
	}
	.product-price {
		font-size: 2rem;
		font-weight: 800;
		color: var(--color-brand, #0066cc);
	}
	.product-description {
		font-size: 1.05rem;
		line-height: 1.65;
		color: var(--color-text-secondary, #334155);
		margin-bottom: 2rem;
	}
	.checkout-card {
		background: var(--color-surface, #ffffff);
		border: 1px solid var(--color-border, #e2e8f0);
		border-radius: 16px;
		padding: 1.5rem;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
		margin-bottom: 1.75rem;
	}
	.stock-label {
		font-size: 0.875rem;
		font-weight: 600;
		color: #16a34a;
		margin-bottom: 1rem;
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}
	.checkout-btn {
		width: 100%;
		background: var(--color-brand, #0066cc);
		color: #ffffff;
		border: none;
		padding: 0.95rem 1.5rem;
		border-radius: 12px;
		font-size: 1.05rem;
		font-weight: 700;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		transition: background 0.15s ease, transform 0.15s ease;
		margin-bottom: 0.75rem;
	}
	.checkout-btn:hover:not(:disabled) {
		background: var(--color-brand-hover, #004499);
		transform: translateY(-1px);
	}
	.checkout-btn:disabled {
		background: var(--color-border, #cbd5e1);
		cursor: not-allowed;
	}
	.pickup-note {
		font-size: 0.8125rem;
		color: var(--color-muted, #64748b);
		margin: 0;
		line-height: 1.4;
	}

	.recipe-synergy-card {
		background: var(--color-bg-subtle, #f8fafc);
		border: 1.5px solid var(--color-brand, #0066cc);
		border-radius: 16px;
		padding: 1.25rem 1.5rem;
	}

	.synergy-header {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 0.85rem;
	}

	.synergy-icon {
		font-size: 1.5rem;
	}

	.synergy-title {
		font-size: 1.05rem;
		font-weight: 700;
		margin: 0;
		color: var(--color-text, #0f172a);
	}

	.synergy-subtitle {
		font-size: 0.8125rem;
		color: var(--color-text-secondary, #475569);
		margin: 0;
	}

	.synergy-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--color-brand, #0066cc);
		color: #ffffff !important;
		font-weight: 700;
		font-size: 0.9375rem;
		padding: 0.65rem 1.25rem;
		border-radius: 10px;
		text-decoration: none;
		transition: background 0.15s ease;
	}
	.synergy-btn:hover {
		background: var(--color-brand-hover, #004499);
	}

	.comments-section {
		border-top: 1px solid var(--color-border, #e2e8f0);
		padding-top: 3rem;
	}
	.comments-heading {
		font-size: 1.5rem;
		font-weight: 700;
		margin-bottom: 1.5rem;
	}

	@media (max-width: 768px) {
		.product-grid {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
	}
</style>
