---
import { getEmDashCollection, getSiteSettings } from "emdash";
import { Image } from "emdash/ui";
import Base from "../layouts/Base.astro";
import RecipeCard from "../components/RecipeCard.astro";
import ProductCard from "../components/ProductCard.astro";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

const [
	{ entries: recipes, cacheHint: recipeCache },
	{ entries: products, cacheHint: productCache },
	settings,
] = await Promise.all([
	getEmDashCollection("recipes", { orderBy: { createdAt: "desc" }, limit: 3 }),
	getEmDashCollection("products", { orderBy: { createdAt: "desc" }, limit: 3 }),
	getSiteSettings(),
]);

const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

if (Astro.cache?.enabled) {
	Astro.cache.set(recipeCache);
	Astro.cache.set(productCache);
}
---

<Base title={siteTitle} description={siteTagline}>
	<!-- Hero Section -->
	<section class="hero-banner">
		<div class="hero-container">
			<div class="hero-content">
				<span class="hero-badge">Artisanal Cottage Bakery & Kitchen</span>
				<h1 class="hero-title">Handcrafted Sourdough & Kitchen Recipes</h1>
				<p class="hero-subtitle">
					From 36-hour cold fermented wild yeast boules to buttery cardamom knots. Baked in small batches locally under Cottage Food License #CFO-LA-2026-9481.
				</p>
				<div class="hero-buttons">
					<a href="/shop" class="btn-primary">Pre-Order Cottage Bakery &rarr;</a>
					<a href="/recipes" class="btn-secondary">Explore Recipes</a>
				</div>
			</div>
		</div>
	</section>

	<div class="home-content container">
		<!-- Featured Cottage Bakery Storefront Section -->
		{products && products.length > 0 && (
			<section class="section-block">
				<header class="section-header">
					<div>
						<span class="section-tag">Weekly Pre-Orders</span>
						<h2 class="section-heading">Cottage Bakery Shop</h2>
					</div>
					<a href="/shop" class="section-link">View All Bakery Items &rarr;</a>
				</header>

				<div class="products-grid">
					{products.map((product) => (
						<ProductCard product={product} />
					))}
				</div>
			</section>
		)}

		<!-- Featured Recipes Section -->
		{recipes && recipes.length > 0 && (
			<section class="section-block">
				<header class="section-header">
					<div>
						<span class="section-tag">From the Journal</span>
						<h2 class="section-heading">Kitchen Recipes & Guides</h2>
					</div>
					<a href="/recipes" class="section-link">View All Recipes &rarr;</a>
				</header>

				<div class="recipes-grid">
					{recipes.map((recipe) => (
						<RecipeCard recipe={recipe} />
					))}
				</div>
			</section>
		)}

		<!-- Cottage Food Compliance Notice -->
		<section class="cottage-declaration-card">
			<div class="declaration-icon">🏡</div>
			<div class="declaration-text">
				<h3>Registered Cottage Food Operation</h3>
				<p>
					All food products sold through Nakita's Kitchen are produced under Cottage Food Operation License #CFO-LA-2026-9481. Every item lists full ingredients, allergen disclosures, and net weight for transparent home kitchen baking.
				</p>
			</div>
		</section>
	</div>
</Base>

<style>
	.hero-banner {
		background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
		color: #ffffff;
		padding: 4.5rem 1.5rem;
		text-align: center;
	}
	.hero-container {
		max-width: 800px;
		margin: 0 auto;
	}
	.hero-badge {
		background: rgba(255, 255, 255, 0.15);
		color: #38bdf8;
		font-weight: 600;
		font-size: 0.8125rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		padding: 0.35rem 0.9rem;
		border-radius: 20px;
		display: inline-block;
		margin-bottom: 1.25rem;
	}
	.hero-title {
		font-size: clamp(2.25rem, 5vw, 3.5rem);
		font-weight: 800;
		line-height: 1.15;
		margin: 0 0 1.25rem 0;
		letter-spacing: -0.02em;
	}
	.hero-subtitle {
		font-size: 1.1875rem;
		color: #94a3b8;
		line-height: 1.6;
		margin: 0 0 2rem 0;
	}
	.hero-buttons {
		display: flex;
		justify-content: center;
		gap: 1rem;
		flex-wrap: wrap;
	}
	.btn-primary {
		background: var(--color-brand, #0066cc);
		color: #ffffff;
		padding: 0.85rem 1.75rem;
		border-radius: 8px;
		font-weight: 700;
		text-decoration: none;
		transition: transform 0.2s ease, background 0.2s ease;
	}
	.btn-primary:hover {
		background: var(--color-brand-hover, #0052a3);
		transform: translateY(-2px);
	}
	.btn-secondary {
		background: rgba(255, 255, 255, 0.1);
		color: #ffffff;
		padding: 0.85rem 1.75rem;
		border-radius: 8px;
		font-weight: 600;
		text-decoration: none;
		border: 1px solid rgba(255, 255, 255, 0.2);
		transition: background 0.2s ease;
	}
	.btn-secondary:hover {
		background: rgba(255, 255, 255, 0.2);
	}
	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 3.5rem 1.5rem;
	}
	.section-block {
		margin-bottom: 4rem;
	}
	.section-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		margin-bottom: 2rem;
		border-bottom: 1px solid var(--color-border, #e2e8f0);
		padding-bottom: 1rem;
	}
	.section-tag {
		font-size: 0.8125rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		font-weight: 600;
		color: var(--color-brand, #0066cc);
	}
	.section-heading {
		font-size: 1.875rem;
		font-weight: 700;
		color: var(--color-text, #0f172a);
		margin: 0.25rem 0 0 0;
	}
	.section-link {
		color: var(--color-brand, #0066cc);
		font-weight: 600;
		text-decoration: none;
		font-size: 0.9375rem;
	}
	.products-grid,
	.recipes-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
		gap: 2rem;
	}
	.cottage-declaration-card {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		background: var(--color-bg-subtle, #f8fafc);
		border: 1px solid var(--color-border, #e2e8f0);
		border-radius: 16px;
		padding: 2rem;
	}
	.declaration-icon {
		font-size: 2.5rem;
	}
	.declaration-text h3 {
		margin: 0 0 0.4rem 0;
		font-weight: 700;
		color: var(--color-text, #0f172a);
	}
	.declaration-text p {
		margin: 0;
		font-size: 0.9375rem;
		color: var(--color-text-secondary, #475569);
		line-height: 1.6;
	}
</style>
