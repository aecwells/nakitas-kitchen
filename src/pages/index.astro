---
import { getEmDashCollection, getSiteSettings } from "emdash";
import { Image } from "emdash/ui";
import Base from "../layouts/Base.astro";
import RecipeCard from "../components/RecipeCard.astro";
import ProductCard from "../components/ProductCard.astro";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

const [
	{ entries: recipes, cacheHint: recipeCache },
	{ entries: products, cacheHint: productCache },
	settings,
] = await Promise.all([
	getEmDashCollection("recipes", { orderBy: { createdAt: "desc" }, limit: 6 }),
	getEmDashCollection("products", { orderBy: { createdAt: "desc" }, limit: 3 }),
	getSiteSettings(),
]);

const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

if (Astro.cache?.enabled) {
	Astro.cache.set(recipeCache);
	Astro.cache.set(productCache);
}
---

<Base title={`${siteTitle} | Live-Fire BBQ & Outdoor Cooking Journal`} description="Low & slow smoking on our Oklahoma Joe DLX 900, wood-fired Kamado Joe bakes, plus artisanal sourdoughs.">
	<!-- BBQ & Outdoor Cooking Hero Section -->
	<section class="hero-banner">
		<div class="hero-container">
			<div class="hero-content">
				<span class="hero-badge">🔥 Live-Fire BBQ & Outdoor Cooking Journal</span>
				<h1 class="hero-title">Smoked Barbecue & Outdoor Cooking</h1>
				<p class="hero-subtitle">
					Low & slow smoking on our <strong>Oklahoma Joe DLX 900</strong>, 700°F wood-fired <strong>Kamado Joe Classic III</strong> bakes & Joetisserie spit roasts, plus artisanal sourdoughs and cottage bakery pre-orders.
				</p>
				<div class="hero-buttons">
					<a href="/recipes" class="btn-primary">🔥 Explore BBQ & Smoker Recipes &rarr;</a>
					<a href="/shop" class="btn-secondary">🥖 Cottage Bakery Pre-Orders</a>
				</div>
			</div>
		</div>
	</section>

	<div class="home-content container">
		<!-- Featured BBQ & Outdoor Recipes Section -->
		{recipes && recipes.length > 0 && (
			<section class="section-block">
				<header class="section-header">
					<div>
						<span class="section-badge">🔥 Outdoor Smoker & Cooking Journal</span>
						<h2 class="section-title">Latest Smoker & Kitchen Recipes</h2>
					</div>
					<a href="/recipes" class="section-link">View All Recipes &rarr;</a>
				</header>
				<div class="grid-layout">
					{recipes.map((recipe) => (
						<RecipeCard recipe={recipe} />
					))}
				</div>
			</section>
		)}

		<!-- Featured Cottage Bakery Storefront Section -->
		{products && products.length > 0 && (
			<section class="section-block">
				<header class="section-header">
					<div>
						<span class="section-badge cottage">🥖 Fresh Saturday Bakes</span>
						<h2 class="section-title">Cottage Bakery Pre-Orders</h2>
					</div>
					<a href="/shop" class="section-link">Visit Bakery Shop &rarr;</a>
				</header>
				<div class="grid-layout">
					{products.map((product) => (
						<ProductCard product={product} />
					))}
				</div>
			</section>
		)}
	</div>
</Base>

<style>
	.hero-banner {
		background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
		color: #ffffff;
		padding: 4.5rem 1.5rem;
		text-align: center;
		border-bottom: 1px solid var(--color-border, #334155);
	}
	.hero-container {
		max-width: 800px;
		margin: 0 auto;
	}
	.hero-badge {
		display: inline-block;
		background: rgba(217, 119, 6, 0.2);
		border: 1px solid rgba(217, 119, 6, 0.5);
		color: #f59e0b;
		font-weight: 700;
		font-size: 0.8125rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		padding: 0.35rem 1rem;
		border-radius: 20px;
		margin-bottom: 1rem;
	}
	.hero-title {
		font-size: 3rem;
		font-weight: 800;
		margin: 0 0 1.25rem 0;
		line-height: 1.15;
		letter-spacing: -0.02em;
		color: #ffffff;
	}
	.hero-subtitle {
		font-size: 1.15rem;
		line-height: 1.65;
		color: #94a3b8;
		margin: 0 0 2rem 0;
	}
	.hero-subtitle strong {
		color: #f8fafc;
	}
	.hero-buttons {
		display: flex;
		justify-content: center;
		gap: 1rem;
		flex-wrap: wrap;
	}
	.btn-primary {
		background: #d97706;
		color: #ffffff;
		font-weight: 700;
		font-size: 1rem;
		padding: 0.85rem 1.6rem;
		border-radius: 12px;
		text-decoration: none;
		transition: background 0.15s ease, transform 0.15s ease;
	}
	.btn-primary:hover {
		background: #b45309;
		transform: translateY(-1px);
	}
	.btn-secondary {
		background: rgba(255, 255, 255, 0.1);
		color: #ffffff;
		border: 1px solid rgba(255, 255, 255, 0.2);
		font-weight: 600;
		font-size: 1rem;
		padding: 0.85rem 1.6rem;
		border-radius: 12px;
		text-decoration: none;
		transition: background 0.15s ease;
	}
	.btn-secondary:hover {
		background: rgba(255, 255, 255, 0.2);
	}

	.home-content {
		max-width: 1240px;
		margin: 0 auto;
		padding: 4rem 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 4rem;
	}

	.section-block {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.section-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
	}

	.section-badge {
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: #d97706;
	}

	.section-badge.cottage {
		color: #16a34a;
	}

	.section-title {
		font-size: 1.85rem;
		font-weight: 800;
		color: var(--color-text, #0f172a);
		margin: 0.25rem 0 0 0;
	}

	.section-link {
		color: var(--color-brand, #0066cc);
		font-weight: 700;
		font-size: 0.9375rem;
		text-decoration: none;
	}

	.section-link:hover {
		text-decoration: underline;
	}

	.grid-layout {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
		gap: 2rem;
	}
</style>
