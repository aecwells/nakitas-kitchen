---
import { getEmDashCollection, getTaxonomyTerms } from "emdash";
import Base from "../../layouts/Base.astro";
import RecipeCard from "../../components/RecipeCard.astro";

const [
	{ entries: recipes, cacheHint },
	categoryTerms,
	tagTerms,
] = await Promise.all([
	getEmDashCollection("recipes", { orderBy: { createdAt: "desc" } }),
	getTaxonomyTerms("category").catch(() => []),
	getTaxonomyTerms("tag").catch(() => []),
]);

Astro.cache.set(cacheHint);

// Group categories into parent categories and sub-categories from EmDash CMS
const parentCategories = categoryTerms.filter((term: any) => !term.parentId && !term.parent);
const getSubCategories = (parentSlug: string, parentId?: string) => {
	return categoryTerms.filter(
		(term: any) => term.parent === parentSlug || (parentId && term.parentId === parentId)
	);
};
---

<Base title="Recipes & Barbecue Journal | Nakita's Kitchen" description="Handcrafted sourdough, outdoor smoker recipes on Kamado Joe and Oklahoma Joe, and meal kit favorites.">
	<div class="container main-page-wrapper">
		<header class="page-header">
			<div class="header-top">
				<span class="badge">From Our Kitchen & Outdoor Smoker</span>
				<a href="/recipes/scan" class="scan-cta-btn">
					<span>📷 Scan Recipe Card</span>
				</a>
			</div>
			<h1 class="page-title">Recipes & Cooking Journal</h1>
			<p class="page-description">
				Slow-fermented sourdoughs, outdoor barbecue on our <strong>Kamado Joe Classic III</strong> & <strong>Oklahoma Joe DLX 900</strong>, plus imported <strong>HomeChef</strong> and <strong>HelloFresh</strong> favorites.
			</p>
		</header>

		<!-- 2-Column Sidebar Widget Layout -->
		<div class="page-layout-container">
			<!-- LEFT SIDEBAR FILTER WIDGETS -->
			<aside class="sidebar-widgets-col">
				<div class="sidebar-widget">
					<h4 class="widget-title">🔍 Search Ingredients</h4>
					<div class="ingredient-search-box">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="search-icon">
							<circle cx="11" cy="11" r="8"></circle>
							<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
						</svg>
						<input
							type="text"
							id="ingredient-search-input"
							placeholder="Ground Beef, Romaine, Vanilla..."
							class="filter-text-input"
						/>
					</div>
				</div>

				<!-- Dynamic EmDash Categories & Sub-Categories Widget -->
				<div class="sidebar-widget">
					<h4 class="widget-title">📂 Categories (EmDash CMS)</h4>
					<div class="category-tree">
						<button type="button" class="tree-btn active" data-cat="all">
							<span>All Categories</span>
							<span class="count-pill">{recipes.length}</span>
						</button>
						
						{parentCategories.map((parent: any) => {
							const subs = getSubCategories(parent.slug, parent.id);
							return (
								<div class="tree-group">
									<button type="button" class="tree-parent-btn" data-cat={parent.slug}>
										<span>{parent.label || parent.name}</span>
										{parent.count !== undefined && <span class="count-pill">{parent.count}</span>}
									</button>
									{subs.length > 0 && (
										<div class="tree-sub-group">
											{subs.map((sub: any) => (
												<button type="button" class="tree-sub-btn" data-cat={sub.slug}>
													<span>↳ {sub.label || sub.name}</span>
													{sub.count !== undefined && <span class="count-pill">{sub.count}</span>}
												</button>
											))}
										</div>
									)}
								</div>
							);
						})}
					</div>
				</div>

				<!-- Ingredient Variation & Form Types Widget -->
				<div class="sidebar-widget">
					<h4 class="widget-title">🌿 Ingredient Form & Variations</h4>
					<div class="variation-chips">
						<span class="var-group-label">Vanilla:</span>
						<button type="button" class="var-chip" data-var="vanilla paste">Paste</button>
						<button type="button" class="var-chip" data-var="vanilla extract">Extract</button>
						
						<span class="var-group-label">Lettuce:</span>
						<button type="button" class="var-chip" data-var="romaine">Romaine</button>
						<button type="button" class="var-chip" data-var="iceberg">Iceberg</button>

						<span class="var-group-label">Flour Type:</span>
						<button type="button" class="var-chip" data-var="bread flour">Bread Flour</button>
						<button type="button" class="var-chip" data-var="rye">Whole Rye</button>

						<span class="var-group-label">Cheese Type:</span>
						<button type="button" class="var-chip" data-var="white cheddar">White Cheddar</button>
						<button type="button" class="var-chip" data-var="mozzarella">Mozzarella</button>
					</div>
				</div>

				<!-- Dynamic EmDash Tags Cloud -->
				{tagTerms && tagTerms.length > 0 && (
					<div class="sidebar-widget">
						<h4 class="widget-title">🏷️ Popular Tags</h4>
						<div class="tags-cloud">
							{tagTerms.map((tag: any) => (
								<button type="button" class="tag-cloud-chip" data-tag={tag.slug}>
									#{tag.label || tag.name}
								</button>
							))}
						</div>
					</div>
				)}

				<div class="sidebar-widget">
					<h4 class="widget-title">📌 Recipe Source</h4>
					<select id="source-filter-select" class="filter-select">
						<option value="all">All Sources</option>
						<option value="hellofresh">HelloFresh Cards</option>
						<option value="homechef">HomeChef Cards</option>
						<option value="nakita">Nakita's Original</option>
					</select>
				</div>

				<div class="sidebar-widget">
					<h4 class="widget-title">⏱️ Duration & Allergen</h4>
					<div class="select-stack">
						<select id="cooktime-filter-select" class="filter-select">
							<option value="all">Any Duration</option>
							<option value="quick">Quick (&le; 30 mins)</option>
							<option value="medium">Under 1 Hour</option>
							<option value="slow">Slow Smoked (&gt; 1 hr)</option>
						</select>
						<select id="allergen-filter-select" class="filter-select">
							<option value="all">All Ingredients</option>
							<option value="no-dairy">Dairy-Free (No Milk/Butter)</option>
							<option value="no-wheat">Wheat/Gluten-Free</option>
						</select>
					</div>
				</div>
			</aside>

			<!-- RIGHT MAIN RECIPES GRID -->
			<main class="main-content-col">
				{recipes && recipes.length > 0 ? (
					<div class="recipes-grid" id="recipes-grid">
						{recipes.map((recipe) => (
							<RecipeCard recipe={recipe} />
						))}
					</div>
				) : (
					<div class="empty-state">
						<p>No recipes found yet. Check back soon for fresh baking guides!</p>
					</div>
				)}
			</main>
		</div>
	</div>
</Base>

<script>
	document.addEventListener("DOMContentLoaded", () => {
		const searchInput = document.getElementById("ingredient-search-input") as HTMLInputElement;
		const sourceSelect = document.getElementById("source-filter-select") as HTMLSelectElement;
		const cooktimeSelect = document.getElementById("cooktime-filter-select") as HTMLSelectElement;
		const allergenSelect = document.getElementById("allergen-filter-select") as HTMLSelectElement;
		const treeBtns = document.querySelectorAll(".tree-btn, .tree-parent-btn, .tree-sub-btn");
		const varChips = document.querySelectorAll(".var-chip");
		const tagChips = document.querySelectorAll(".tag-cloud-chip");
		const cards = document.querySelectorAll(".recipe-card");

		let activeCat = "all";
		let activeVar = "";
		let activeTag = "";

		function applyFilters() {
			const query = (searchInput?.value || "").toLowerCase().trim();
			const sourceFilter = sourceSelect?.value || "all";
			const cooktimeFilter = cooktimeSelect?.value || "all";
			const allergenFilter = allergenSelect?.value || "all";

			cards.forEach((card) => {
				const el = card as HTMLElement;
				const title = el.getAttribute("data-title") || "";
				const source = el.getAttribute("data-source") || "";
				const equipment = el.getAttribute("data-equipment") || "";
				const cook = el.getAttribute("data-cook") || "";
				const ingredients = el.getAttribute("data-ingredients") || "";
				const allergens = el.getAttribute("data-allergens") || "";

				const matchesQuery = !query || title.includes(query) || ingredients.includes(query) || equipment.includes(query);
				const matchesSource = sourceFilter === "all" || source.includes(sourceFilter);

				// Category Match
				let matchesCat = true;
				if (activeCat !== "all") {
					if (activeCat === "breads") matchesCat = title.includes("sourdough") || title.includes("bread") || ingredients.includes("flour");
					else if (activeCat === "country-sourdough") matchesCat = title.includes("sourdough") || title.includes("country");
					else if (activeCat === "jalapeno-cheddar") matchesCat = title.includes("jalapeno") || title.includes("cheddar");
					else if (activeCat === "pastries" || activeCat === "cookies") matchesCat = title.includes("knot") || title.includes("shortbread") || title.includes("cookie") || title.includes("biscuits");
					else if (activeCat === "cardamom-knots") matchesCat = title.includes("cardamom") || title.includes("knot");
					else if (activeCat === "shortbread-cookies") matchesCat = title.includes("shortbread") || title.includes("cookie");
					else if (activeCat === "outdoor-bbq") matchesCat = equipment.includes("kamado") || equipment.includes("oklahoma") || title.includes("smoked") || title.includes("chicken");
					else if (activeCat === "kamado-joe") matchesCat = equipment.includes("kamado");
					else if (activeCat === "oklahoma-joe") matchesCat = equipment.includes("oklahoma");
					else matchesCat = title.includes(activeCat) || ingredients.includes(activeCat);
				}

				// Variation match
				const matchesVar = !activeVar || ingredients.includes(activeVar) || title.includes(activeVar);

				// Tag match
				const matchesTag = !activeTag || title.includes(activeTag) || ingredients.includes(activeTag);

				let matchesCooktime = true;
				if (cooktimeFilter === "quick") {
					matchesCooktime = cook.includes("15") || cook.includes("20") || cook.includes("25") || cook.includes("30") || cook.includes("10");
				} else if (cooktimeFilter === "medium") {
					matchesCooktime = !cook.includes("90") && !cook.includes("2 hour") && !cook.includes("3 hour");
				} else if (cooktimeFilter === "slow") {
					matchesCooktime = cook.includes("hour") || cook.includes("60") || cook.includes("90") || cook.includes("120");
				}

				let matchesAllergen = true;
				if (allergenFilter === "no-dairy") {
					matchesAllergen = !allergens.includes("dairy") && !allergens.includes("milk") && !ingredients.includes("cheddar") && !ingredients.includes("cheese");
				} else if (allergenFilter === "no-wheat") {
					matchesAllergen = !allergens.includes("wheat") && !allergens.includes("gluten") && !ingredients.includes("flour") && !ingredients.includes("bun");
				}

				if (matchesQuery && matchesSource && matchesCat && matchesVar && matchesTag && matchesCooktime && matchesAllergen) {
					el.style.display = "";
				} else {
					el.style.display = "none";
				}
			});
		}

		searchInput?.addEventListener("input", applyFilters);
		sourceSelect?.addEventListener("change", applyFilters);
		cooktimeSelect?.addEventListener("change", applyFilters);
		allergenSelect?.addEventListener("change", applyFilters);

		treeBtns.forEach((btn) => {
			btn.addEventListener("click", () => {
				treeBtns.forEach((b) => b.classList.remove("active"));
				btn.classList.add("active");
				activeCat = btn.getAttribute("data-cat") || "all";
				applyFilters();
			});
		});

		varChips.forEach((chip) => {
			chip.addEventListener("click", () => {
				if (chip.classList.contains("active")) {
					chip.classList.remove("active");
					activeVar = "";
				} else {
					varChips.forEach((c) => c.classList.remove("active"));
					chip.classList.add("active");
					activeVar = chip.getAttribute("data-var") || "";
				}
				applyFilters();
			});
		});

		tagChips.forEach((chip) => {
			chip.addEventListener("click", () => {
				if (chip.classList.contains("active")) {
					chip.classList.remove("active");
					activeTag = "";
				} else {
					tagChips.forEach((c) => c.classList.remove("active"));
					chip.classList.add("active");
					activeTag = chip.getAttribute("data-tag") || "";
				}
				applyFilters();
			});
		});
	});
</script>

<style>
	.main-page-wrapper {
		max-width: 1280px;
		margin: 0 auto;
		padding: 2.5rem 1.5rem 4rem 1.5rem;
	}
	.page-header {
		text-align: center;
		max-width: 720px;
		margin: 0 auto 2.5rem auto;
	}
	.header-top {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 1rem;
		margin-bottom: 0.75rem;
		flex-wrap: wrap;
	}
	.badge {
		background: rgba(0, 102, 204, 0.08);
		color: var(--color-brand, #0066cc);
		font-weight: 600;
		font-size: 0.8125rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		padding: 0.3rem 0.8rem;
		border-radius: 20px;
	}
	.scan-cta-btn {
		background: #d97706;
		color: #ffffff;
		font-weight: 700;
		font-size: 0.8125rem;
		padding: 0.35rem 0.85rem;
		border-radius: 20px;
		text-decoration: none;
		transition: background 0.15s ease, transform 0.15s ease;
	}
	.scan-cta-btn:hover {
		background: #b45309;
		transform: translateY(-1px);
	}
	.page-title {
		font-size: 2.5rem;
		font-weight: 700;
		color: var(--color-text, #0f172a);
		margin: 0 0 0.75rem 0;
		letter-spacing: -0.02em;
	}
	.page-description {
		font-size: 1.1rem;
		color: var(--color-text-secondary, #475569);
		line-height: 1.6;
		margin: 0;
	}

	/* 2-Column Sidebar Layout */
	.page-layout-container {
		display: grid;
		grid-template-columns: 280px 1fr;
		gap: 2.5rem;
		align-items: start;
	}

	.sidebar-widgets-col {
		position: sticky;
		top: 90px;
		max-height: calc(100vh - 110px);
		overflow-y: auto;
		overflow-x: hidden;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		background: var(--color-surface, #ffffff);
		border: 1px solid var(--color-border, #e2e8f0);
		border-radius: 16px;
		padding: 1.25rem;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
		box-sizing: border-box;
		scrollbar-width: thin;
	}

	.sidebar-widget {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--color-border-subtle, #f1f5f9);
		width: 100%;
		box-sizing: border-box;
	}

	.sidebar-widget:last-child {
		border-bottom: none;
		padding-bottom: 0;
	}

	.widget-title {
		font-size: 0.8125rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--color-text, #0f172a);
		margin: 0;
	}

	.ingredient-search-box {
		position: relative;
		width: 100%;
		box-sizing: border-box;
	}

	.search-icon {
		position: absolute;
		left: 0.75rem;
		top: 50%;
		transform: translateY(-50%);
		color: var(--color-muted, #94a3b8);
	}

	.filter-text-input {
		width: 100%;
		max-width: 100%;
		box-sizing: border-box;
		padding: 0.6rem 0.6rem 0.6rem 2.2rem;
		font-size: 0.85rem;
		border: 1px solid var(--color-border, #cbd5e1);
		border-radius: 8px;
		background: var(--color-bg, #f8fafc);
		color: var(--color-text, #0f172a);
	}

	.filter-text-input:focus {
		outline: none;
		border-color: var(--color-brand, #0066cc);
	}

	/* Category Tree Styling */
	.category-tree {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.tree-group {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}

	.tree-btn, .tree-parent-btn {
		display: flex;
		justify-content: space-between;
		align-items: center;
		text-align: left;
		background: var(--color-bg-subtle, #f8fafc);
		border: 1px solid var(--color-border, #e2e8f0);
		color: var(--color-text, #0f172a);
		padding: 0.45rem 0.75rem;
		border-radius: 8px;
		font-size: 0.85rem;
		font-weight: 700;
		cursor: pointer;
		transition: all 0.15s ease;
	}

	.tree-sub-group {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding-left: 0.85rem;
	}

	.tree-sub-btn {
		display: flex;
		justify-content: space-between;
		align-items: center;
		text-align: left;
		background: transparent;
		border: 1px solid transparent;
		color: var(--color-text-secondary, #475569);
		padding: 0.3rem 0.6rem;
		border-radius: 6px;
		font-size: 0.8rem;
		font-weight: 600;
		cursor: pointer;
		transition: all 0.15s ease;
	}

	.tree-sub-btn:hover {
		color: var(--color-brand, #0066cc);
		background: var(--color-bg-subtle, #f1f5f9);
	}

	.tree-btn.active, .tree-parent-btn.active, .tree-sub-btn.active {
		background: var(--color-brand, #0066cc);
		color: #ffffff;
		border-color: var(--color-brand, #0066cc);
	}

	.count-pill {
		font-size: 0.7rem;
		background: rgba(0, 0, 0, 0.08);
		padding: 0.1rem 0.45rem;
		border-radius: 10px;
	}

	.tree-btn.active .count-pill, .tree-parent-btn.active .count-pill, .tree-sub-btn.active .count-pill {
		background: rgba(255, 255, 255, 0.25);
		color: #ffffff;
	}

	/* Variation Chips Styling */
	.variation-chips, .tags-cloud {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		align-items: center;
	}

	.var-group-label {
		width: 100%;
		font-size: 0.7rem;
		font-weight: 700;
		text-transform: uppercase;
		color: var(--color-muted, #64748b);
		margin-top: 0.35rem;
	}

	.var-chip, .tag-cloud-chip {
		background: var(--color-bg-subtle, #f1f5f9);
		border: 1px solid var(--color-border, #cbd5e1);
		color: var(--color-text, #0f172a);
		padding: 0.25rem 0.55rem;
		border-radius: 12px;
		font-size: 0.75rem;
		font-weight: 600;
		cursor: pointer;
		transition: all 0.15s ease;
	}

	.var-chip:hover, .tag-cloud-chip:hover {
		border-color: var(--color-brand, #0066cc);
		color: var(--color-brand, #0066cc);
	}

	.var-chip.active, .tag-cloud-chip.active {
		background: var(--color-brand, #0066cc);
		color: #ffffff;
		border-color: var(--color-brand, #0066cc);
	}

	.select-stack {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.filter-select {
		width: 100%;
		padding: 0.55rem 0.65rem;
		font-size: 0.8125rem;
		font-weight: 600;
		border: 1px solid var(--color-border, #cbd5e1);
		border-radius: 8px;
		background: var(--color-bg, #f8fafc);
		color: var(--color-text, #0f172a);
		cursor: pointer;
	}

	.main-content-col {
		flex: 1;
	}

	.recipes-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 2rem;
	}

	.empty-state {
		text-align: center;
		padding: 4rem 1rem;
		color: var(--color-muted, #64748b);
	}

	@media (max-width: 900px) {
		.page-layout-container {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.sidebar-widgets-col {
			position: static;
		}
	}
</style>
