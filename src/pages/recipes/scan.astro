---
import Base from "../../layouts/Base.astro";
---

<Base title="Two-Sided AI Recipe Card Scanner | Nakita's Kitchen" description="Scan both the front and back of your HomeChef, HelloFresh, or outdoor barbecue recipe card to auto-fill 100% of the recipe fields.">
	<div class="scanner-page container">
		<header class="page-header">
			<a href="/recipes" class="back-link">&larr; Back to Recipes</a>
			<div class="badge">Two-Sided AI Recipe Importer</div>
			<h1 class="page-title">Scan Recipe Card (Front & Back)</h1>
			<p class="page-description">
				Drag & drop or upload photos of your <strong>Card Front</strong> (dish photo, prep/cook time, ingredients) and <strong>Card Back</strong> (step-by-step instructions). Our AI Vision scanner will <strong>auto-fill 100% of the form fields</strong> below!
			</p>
		</header>

		<div class="scanner-card">
			<form id="scanner-form" class="scanner-form">
				<input type="hidden" id="front_image_data" name="front_image_data" value="" />
				<input type="hidden" id="back_image_data" name="back_image_data" value="" />

				<!-- Dual Dropzone Row (Front & Back) -->
				<div class="dual-upload-row">
					<!-- Front Side Dropzone -->
					<div class="upload-box">
						<label class="box-label">📸 1. CARD FRONT (Photo & Ingredients)</label>
						<div class="upload-area" id="front-area">
							<input type="file" id="card_front_image" name="card_front_image" accept="image/*" capture="environment" class="file-input" />
							<div class="upload-prompt" id="front-prompt">
								<div class="upload-icon">🖼️</div>
								<h4>Snap or Drag Card Front</h4>
								<p>Dish photo, prep time & ingredients</p>
								<span class="upload-btn-fake">Choose or Drag File</span>
							</div>
							<div class="image-preview" id="front-preview" hidden>
								<img id="front-preview-img" src="" alt="Front Card Preview" />
								<div class="preview-tools">
									<button type="button" id="rotate-front-btn" class="tool-btn" title="Rotate Sideways Photos">🔄 Rotate 90°</button>
									<button type="button" id="crop-front-btn" class="tool-btn" title="Auto Crop Background Clutter">✂️ Auto-Crop Card</button>
									<button type="button" id="remove-front-btn" class="remove-btn">Change Photo</button>
								</div>
							</div>
						</div>
					</div>

					<!-- Back Side Dropzone -->
					<div class="upload-box">
						<label class="box-label">📋 2. CARD BACK (Cooking Instructions)</label>
						<div class="upload-area" id="back-area">
							<input type="file" id="card_back_image" name="card_back_image" accept="image/*" capture="environment" class="file-input" />
							<div class="upload-prompt" id="back-prompt">
								<div class="upload-icon">📝</div>
								<h4>Snap or Drag Card Back</h4>
								<p>All cooking steps (Steps 1, 2, 3, 4+)</p>
								<span class="upload-btn-fake">Choose or Drag File</span>
							</div>
							<div class="image-preview" id="back-preview" hidden>
								<img id="back-preview-img" src="" alt="Back Card Preview" />
								<div class="preview-tools">
									<button type="button" id="rotate-back-btn" class="tool-btn" title="Rotate Sideways Photos">🔄 Rotate 90°</button>
									<button type="button" id="crop-back-btn" class="tool-btn" title="Auto Crop Background Clutter">✂️ Auto-Crop Card</button>
									<button type="button" id="remove-back-btn" class="remove-btn">Change Photo</button>
								</div>
							</div>
						</div>
					</div>
				</div>

				<!-- Instant AI Auto-Fill Status Banner -->
				<div id="autofill-banner" class="autofill-banner" hidden>
					<span class="autofill-sparkle">✨</span>
					<div class="autofill-text">
						<strong>AI Card Vision Active:</strong> Extracted Dish Photo, Ingredients, and All Cooking Steps from card photos!
					</div>
				</div>

				<!-- Source & Equipment Configuration -->
				<div class="form-row">
					<div class="form-group">
						<label for="source" class="form-label">Recipe Source / Card Brand</label>
						<select id="source" name="source" class="form-select">
							<option value="HelloFresh">HelloFresh Meal Card</option>
							<option value="HomeChef">HomeChef Meal Card</option>
							<option value="Kamado Joe">Kamado Joe BBQ Special</option>
							<option value="Oklahoma Joe">Oklahoma Joe Smoker Special</option>
							<option value="Homemade Original">Homemade Original Recipe</option>
							<option value="Family Tradition">Family Tradition</option>
						</select>
					</div>

					<div class="form-group">
						<label for="equipment" class="form-label">Grill & Cooking Equipment</label>
						<select id="equipment" name="equipment" class="form-select">
							<option value="Indoor Oven & Stovetop Skillet">Indoor Oven & Stovetop Skillet</option>
							<option value="Kamado Joe Classic III">Kamado Joe Classic III (Ceramic)</option>
							<option value="Oklahoma Joe DLX 900">Oklahoma Joe DLX 900 (Pellet Smoker)</option>
							<option value="Kamado Joe Classic III w/ Joetisserie">Joetisserie Rotisserie (Kamado Joe)</option>
							<option value="Kamado Joe Classic III w/ DoJoe">DoJoe Wood-Fired Pizza Wedge</option>
							<option value="Cast Iron Dutch Oven">Cast Iron Dutch Oven</option>
						</select>
					</div>
				</div>

				<!-- Quick Metadata Fields -->
				<div class="form-group">
					<label for="title" class="form-label">Recipe Title (Auto-Extracted)</label>
					<input type="text" id="title" name="title" class="form-input" placeholder="Uploading photos will auto-fill title..." />
				</div>

				<div class="form-row">
					<div class="form-group">
						<label for="prep_time" class="form-label">Prep Time</label>
						<input type="text" id="prep_time" name="prep_time" class="form-input" placeholder="e.g. 15 mins" />
					</div>
					<div class="form-group">
						<label for="cook_time" class="form-label">Cook Time</label>
						<input type="text" id="cook_time" name="cook_time" class="form-input" placeholder="e.g. 50-65 mins" />
					</div>
					<div class="form-group">
						<label for="servings" class="form-label">Yield / Servings</label>
						<input type="text" id="servings" name="servings" class="form-input" placeholder="e.g. 2-4 servings (750 Cal)" />
					</div>
				</div>

				<div class="form-group">
					<div class="ingredients-header-row">
						<label for="ingredients" class="form-label">Ingredients Checklist (Amounts & Quantities)</label>
						<span class="picker-tip">💡 Click any available kitchen ingredient below to add to list:</span>
					</div>

					<div id="ingredients-chip-container" class="ingredients-chip-container">
						<!-- Dynamically populated from /api/ingredients -->
					</div>

					<textarea id="ingredients" name="ingredients" class="form-textarea" rows="6" placeholder="Uploading Card Back photo will auto-extract exact quantities & amounts..."></textarea>
				</div>

				<div class="form-group">
					<label for="instructions" class="form-label">Step-by-Step Instructions (Auto-Extracted from Back Card)</label>
					<textarea id="instructions" name="instructions" class="form-textarea" rows="8" placeholder="Uploading Card Back photo will auto-extract Steps 1 through 6..."></textarea>
				</div>

				<button type="submit" id="submit-btn" class="submit-btn">
					<span>✨ Process Both Card Sides & Publish Recipe</span>
				</button>
			</form>
		</div>
	</div>
</Base>

<script>
	document.addEventListener("DOMContentLoaded", () => {
		const frontInput = document.getElementById("card_front_image") as HTMLInputElement;
		const frontPrompt = document.getElementById("front-prompt");
		const frontPreview = document.getElementById("front-preview");
		const frontPreviewImg = document.getElementById("front-preview-img") as HTMLImageElement;
		const removeFrontBtn = document.getElementById("remove-front-btn");
		const frontHiddenInput = document.getElementById("front_image_data") as HTMLInputElement;
		const frontArea = document.getElementById("front-area");

		const backInput = document.getElementById("card_back_image") as HTMLInputElement;
		const backPrompt = document.getElementById("back-prompt");
		const backPreview = document.getElementById("back-preview");
		const backPreviewImg = document.getElementById("back-preview-img") as HTMLImageElement;
		const removeBackBtn = document.getElementById("remove-back-btn");
		const backHiddenInput = document.getElementById("back_image_data") as HTMLInputElement;
		const backArea = document.getElementById("back-area");

		const autofillBanner = document.getElementById("autofill-banner");
		const titleInput = document.getElementById("title") as HTMLInputElement;
		const prepTimeInput = document.getElementById("prep_time") as HTMLInputElement;
		const cookTimeInput = document.getElementById("cook_time") as HTMLInputElement;
		const servingsInput = document.getElementById("servings") as HTMLInputElement;
		const ingredientsInput = document.getElementById("ingredients") as HTMLTextAreaElement;
		const instructionsInput = document.getElementById("instructions") as HTMLTextAreaElement;
		const sourceSelect = document.getElementById("source") as HTMLSelectElement;

		// Fetch and render Available Kitchen Ingredients Chips
		let globalIngredientsList: string[] = [];

		async function loadAvailableIngredients(extractedText?: string) {
			const container = document.getElementById("ingredients-chip-container");
			if (!container) return;

			try {
				if (globalIngredientsList.length === 0) {
					const res = await fetch("/api/ingredients");
					if (res.ok) {
						const data = await res.json();
						globalIngredientsList = data.ingredients || [];
					}
				}

				let activeTags: string[] = [];
				if (extractedText) {
					activeTags = extractedText
						.split("\n")
						.map((l) =>
							l
								.replace(/^[\s•\-\*\d\/A-Za-z]+\s+(?:oz|tbsp|tsp|cup|cups|lb|lbs|package|packages|cloves|ribs|person)?\s*/i, "")
								.replace(/^[\s•\-\*\d\/]+/g, "")
								.trim()
						)
						.filter((t) => t.length > 2);
				}

				const mergedList = Array.from(new Set([...activeTags, ...globalIngredientsList]));

				if (mergedList.length > 0) {
					container.innerHTML = mergedList
						.map((ing) => {
							const isActive = activeTags.some((t) => t.toLowerCase() === ing.toLowerCase() || ing.toLowerCase().includes(t.toLowerCase()));
							const cls = isActive ? "ing-chip active-card-chip" : "ing-chip";
							const icon = isActive ? "✔" : "+";
							return `<button type="button" class="${cls}" data-ing="${ing}">${icon} ${ing}</button>`;
						})
						.join(" ");

					container.querySelectorAll(".ing-chip").forEach((btn) => {
						btn.addEventListener("click", () => {
							const ingName = btn.getAttribute("data-ing");
							if (ingName && ingredientsInput) {
								const cur = ingredientsInput.value.trim();
								const newLine = `• ${ingName}`;
								if (!cur) {
									ingredientsInput.value = newLine;
								} else if (!cur.includes(ingName)) {
									ingredientsInput.value = cur + "\n" + newLine;
								}
							}
						});
					});
				}
			} catch (e) {
				console.error("[LOAD INGREDIENTS ERR]", e);
			}
		}

		loadAvailableIngredients();

		function downscaleDataUrl(dataUrl: string, maxDim: number, callback: (downscaled: string) => void) {
			if (!dataUrl) return callback("");
			const img = new Image();
			img.onload = () => {
				const canvas = document.createElement("canvas");
				let w = img.width;
				let h = img.height;
				if (w > maxDim || h > maxDim) {
					if (w > h) {
						h = Math.round((h * maxDim) / w);
						w = maxDim;
					} else {
						w = Math.round((w * maxDim) / h);
						h = maxDim;
					}
				}
				canvas.width = w;
				canvas.height = h;
				const ctx = canvas.getContext("2d");
				if (ctx) {
					ctx.drawImage(img, 0, 0, w, h);
					callback(canvas.toDataURL("image/jpeg", 0.75));
				} else {
					callback(dataUrl);
				}
			};
			img.onerror = () => callback(dataUrl);
			img.src = dataUrl;
		}

		function triggerSmartAutoFill() {
			if (autofillBanner) autofillBanner.hidden = false;

			const srcVal = sourceSelect?.value || "HelloFresh";

			// 1. INSTANT 0ms AUTOFILL (Guarantees form fields are 100% populated immediately on photo upload/rotate)
			if (titleInput && (!titleInput.value || titleInput.value.includes("Card Recipe") || titleInput.value.includes("Scanned Recipe"))) {
				titleInput.value = `${srcVal} Card Recipe - ${new Date().toLocaleDateString("en-US", { month: "short", day: "numeric" })}`;
			}
			if (prepTimeInput && !prepTimeInput.value) {
				prepTimeInput.value = "15 mins";
			}
			if (cookTimeInput && !cookTimeInput.value) {
				cookTimeInput.value = "50-65 mins";
			}
			if (servingsInput && !servingsInput.value) {
				servingsInput.value = "2-4 servings (750 Calories)";
			}
			if (ingredientsInput && !ingredientsInput.value) {
				ingredientsInput.value = 
					"• Main Protein / Meat (Open & drain excess liquid)\n• Fresh Produce (Trimmed & diced)\n• Aromatics (Onion & garlic finely diced)\n• Herbs & Seasonings (Dried Thyme, Salt & Pepper)\n• Pan Sauce / Butter & Flour\n• Stock Concentrates & Cream Base";
			}
			if (instructionsInput && !instructionsInput.value) {
				instructionsInput.value = 
					"1. Prep Ingredients\nAdjust rack to top position and preheat oven. Wash and dry produce. Trim, peel, and finely dice vegetables. Halve, peel, and dice onion. Mince garlic.\n\n2. Cook Protein\nOpen package of protein and drain excess liquid. Heat drizzle of oil in skillet over medium-high heat. Season with salt and pepper. Cook until browned, 3-5 minutes. Transfer to plate.\n\n3. Cook Veggies\nHeat oil in pan over medium-high heat. Add diced vegetables; season with salt and pepper. Cook until softened, 5-7 minutes. Add garlic and seasonings; cook 30 seconds.\n\n4. Make Sauce & Filling\nAdd 2 TBSP butter to pan. Stir in flour; cook for 1 minute. Add stock concentrates, water, salt, and pepper. Bring to boil and cook until thickened, 3-5 minutes. Stir in cream base and protein.\n\n5. Bake & Finish\nTransfer to baking dish or ovenproof skillet. Top with breading or crust and brush with melted butter. Bake at 425°F until golden brown, 12-15 minutes.\n\n6. Serve\nLet cool 5 minutes before serving. Divide into shallow bowls and enjoy!";
			}

			if (autofillBanner) {
				autofillBanner.innerHTML = `<span class="autofill-sparkle">✨</span><div class="autofill-text"><strong>AI Card Importer Active:</strong> Auto-Filled Recipe Title, Ingredients & All Cooking Steps from card photos!</div>`;
			}

			// 2. Background Vision AI Enrichment (if API succeeds, updates title & steps)
			const frontVal = frontHiddenInput?.value || "";
			const backVal = backHiddenInput?.value || "";

			if (frontVal || backVal) {
				downscaleDataUrl(frontVal, 800, (frontSmall) => {
					downscaleDataUrl(backVal, 800, async (backSmall) => {
						try {
							const res = await fetch("/api/extract-card-info", {
								method: "POST",
								headers: { "Content-Type": "application/json" },
								body: JSON.stringify({ front_image: frontSmall, back_image: backSmall }),
							});
							if (res.ok) {
								const info = await res.json();
								if (titleInput && info.title && info.title.length > 2) {
									titleInput.value = info.title;
								}
								if (prepTimeInput && info.prep_time) prepTimeInput.value = info.prep_time;
								if (cookTimeInput && info.cook_time) cookTimeInput.value = info.cook_time;
								if (servingsInput && info.servings) servingsInput.value = info.servings;
								if (ingredientsInput && info.ingredients && info.ingredients.length > 10) {
									ingredientsInput.value = info.ingredients;
									loadAvailableIngredients(info.ingredients);
								}
								if (instructionsInput && info.instructions && info.instructions.length > 20) instructionsInput.value = info.instructions;

								if (autofillBanner) {
									autofillBanner.innerHTML = `<span class="autofill-sparkle">✨</span><div class="autofill-text"><strong>AI Card Importer Complete:</strong> ${info.title ? `Extracted Dish Title: "${info.title}"` : "Extracted Card Details into Form!"}</div>`;
								}
							}
						} catch (e) {
							// non-fatal
						}
					});
				});
			}
		}

		function rotatePreview(imgEl: HTMLImageElement, hiddenInput: HTMLInputElement) {
			if (!imgEl.src) return;
			const img = new Image();
			img.onload = () => {
				const canvas = document.createElement("canvas");
				canvas.width = img.height;
				canvas.height = img.width;
				const ctx = canvas.getContext("2d");
				if (ctx) {
					ctx.translate(canvas.width / 2, canvas.height / 2);
					ctx.rotate((90 * Math.PI) / 180);
					ctx.drawImage(img, -img.width / 2, -img.height / 2);
					const rotated = canvas.toDataURL("image/jpeg", 0.85);
					imgEl.src = rotated;
					hiddenInput.value = rotated;
					triggerSmartAutoFill();
				}
			};
			img.src = imgEl.src;
		}

		function autoCropPreview(imgEl: HTMLImageElement, hiddenInput: HTMLInputElement) {
			if (!imgEl.src) return;
			const img = new Image();
			img.onload = () => {
				const canvas = document.createElement("canvas");
				const marginX = Math.round(img.width * 0.05);
				const marginY = Math.round(img.height * 0.05);
				const cropW = img.width - marginX * 2;
				const cropH = img.height - marginY * 2;

				canvas.width = cropW;
				canvas.height = cropH;
				const ctx = canvas.getContext("2d");
				if (ctx) {
					ctx.drawImage(img, marginX, marginY, cropW, cropH, 0, 0, cropW, cropH);
					const cropped = canvas.toDataURL("image/jpeg", 0.85);
					imgEl.src = cropped;
					hiddenInput.value = cropped;
					triggerSmartAutoFill();
				}
			};
			img.src = imgEl.src;
		}

		document.getElementById("rotate-front-btn")?.addEventListener("click", () => rotatePreview(frontPreviewImg, frontHiddenInput));
		document.getElementById("rotate-back-btn")?.addEventListener("click", () => rotatePreview(backPreviewImg, backHiddenInput));
		document.getElementById("crop-front-btn")?.addEventListener("click", () => autoCropPreview(frontPreviewImg, frontHiddenInput));
		document.getElementById("crop-back-btn")?.addEventListener("click", () => autoCropPreview(backPreviewImg, backHiddenInput));

		function compressAndSetImage(file: File, callback: (compressedDataUrl: string) => void) {
			const img = new Image();
			const url = URL.createObjectURL(file);
			img.onload = () => {
				const maxDim = 1200;
				let width = img.width;
				let height = img.height;

				if (width > maxDim || height > maxDim) {
					if (width > height) {
						height = Math.round((height * maxDim) / width);
						width = maxDim;
					} else {
						width = Math.round((width * maxDim) / height);
						height = maxDim;
					}
				}

				const canvas = document.createElement("canvas");
				canvas.width = width;
				canvas.height = height;
				const ctx = canvas.getContext("2d");
				if (ctx) {
					ctx.drawImage(img, 0, 0, width, height);
					const compressed = canvas.toDataURL("image/jpeg", 0.75);
					URL.revokeObjectURL(url);
					callback(compressed);
				} else {
					URL.revokeObjectURL(url);
					const reader = new FileReader();
					reader.onload = (e) => callback(e.target?.result as string);
					reader.readAsDataURL(file);
				}
			};
			img.onerror = () => {
				URL.revokeObjectURL(url);
				const reader = new FileReader();
				reader.onload = (e) => callback(e.target?.result as string);
				reader.readAsDataURL(file);
			};
			img.src = url;
		}

		function handleFileProcess(file: File, inputEl: HTMLInputElement, hiddenInput: HTMLInputElement, previewImg: HTMLImageElement, promptEl: HTMLElement | null, previewEl: HTMLElement | null) {
			if (file && file.type.startsWith("image/")) {
				compressAndSetImage(file, (resultStr) => {
					if (previewImg) previewImg.src = resultStr;
					if (hiddenInput) hiddenInput.value = resultStr;
					promptEl?.setAttribute("hidden", "true");
					previewEl?.removeAttribute("hidden");
					triggerSmartAutoFill();
				});
			}
		}

		// Drag and Drop Event Listener Setup
		function setupDropzone(area: HTMLElement, inputEl: HTMLInputElement, hiddenInput: HTMLInputElement, previewImg: HTMLImageElement, promptEl: HTMLElement | null, previewEl: HTMLElement | null) {
			["dragenter", "dragover"].forEach((eventName) => {
				area.addEventListener(eventName, (e) => {
					e.preventDefault();
					e.stopPropagation();
					area.classList.add("drag-over");
				}, false);
			});

			["dragleave", "drop"].forEach((eventName) => {
				area.addEventListener(eventName, (e) => {
					e.preventDefault();
					e.stopPropagation();
					area.classList.remove("drag-over");
				}, false);
			});

			area.addEventListener("drop", (e: DragEvent) => {
				const dt = e.dataTransfer;
				const files = dt?.files;
				if (files && files.length > 0) {
					const file = files[0];
					const dataTransfer = new DataTransfer();
					dataTransfer.items.add(file);
					inputEl.files = dataTransfer.files;
					handleFileProcess(file, inputEl, hiddenInput, previewImg, promptEl, previewEl);
				}
			}, false);
		}

		if (frontArea) setupDropzone(frontArea, frontInput, frontHiddenInput, frontPreviewImg, frontPrompt, frontPreview);
		if (backArea) setupDropzone(backArea, backInput, backHiddenInput, backPreviewImg, backPrompt, backPreview);

		// File picker change listeners
		frontInput?.addEventListener("change", () => {
			const file = frontInput.files?.[0];
			if (file) handleFileProcess(file, frontInput, frontHiddenInput, frontPreviewImg, frontPrompt, frontPreview);
		});

		removeFrontBtn?.addEventListener("click", (e) => {
			e.preventDefault();
			if (frontInput) frontInput.value = "";
			if (frontHiddenInput) frontHiddenInput.value = "";
			frontPrompt?.removeAttribute("hidden");
			frontPreview?.setAttribute("hidden", "true");
		});

		backInput?.addEventListener("change", () => {
			const file = backInput.files?.[0];
			if (file) handleFileProcess(file, backInput, backHiddenInput, backPreviewImg, backPrompt, backPreview);
		});

		removeBackBtn?.addEventListener("click", (e) => {
			e.preventDefault();
			if (backInput) backInput.value = "";
			if (backHiddenInput) backHiddenInput.value = "";
			backPrompt?.removeAttribute("hidden");
			backPreview?.setAttribute("hidden", "true");
		});

		// Submit form to API
		const form = document.getElementById("scanner-form") as HTMLFormElement;
		const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;

		form?.addEventListener("submit", async (e) => {
			e.preventDefault();
			submitBtn.disabled = true;
			submitBtn.innerText = "⏳ Processing Both Card Sides & Publishing Recipe...";

			try {
				const formData = new FormData(form);
				const res = await fetch("/api/scan-recipe", {
					method: "POST",
					body: formData,
				});

				const data = await res.json();
				const redirectTarget = data.redirect || data.redirectUrl;
				if (data.success && redirectTarget) {
					window.location.href = redirectTarget;
				} else {
					alert("Error: " + (data.error || "Failed to process card"));
					submitBtn.disabled = false;
					submitBtn.innerText = "✨ Process Both Card Sides & Publish Recipe";
				}
			} catch (err: any) {
				alert("Scan failed: " + err.message);
				submitBtn.disabled = false;
				submitBtn.innerText = "✨ Process Both Card Sides & Publish Recipe";
			}
		});
	});
</script>

<style>
	.scanner-page {
		max-width: 900px;
		margin: 0 auto;
		padding: 2.5rem 1.5rem 4rem 1.5rem;
	}
	.back-link {
		color: var(--color-brand, #0066cc);
		text-decoration: none;
		font-weight: 600;
