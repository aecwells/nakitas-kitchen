---
import Base from "../../layouts/Base.astro";
---

<Base title="Two-Sided AI Recipe Card Scanner | Nakita's Kitchen" description="Scan both the front and back of your HomeChef, HelloFresh, or outdoor barbecue recipe card to create a complete digital recipe.">
	<div class="scanner-page container">
		<header class="page-header">
			<a href="/recipes" class="back-link">&larr; Back to Recipes</a>
			<div class="badge">Two-Sided AI Recipe Importer</div>
			<h1 class="page-title">Scan Recipe Card (Front & Back)</h1>
			<p class="page-description">
				HomeChef and HelloFresh meal cards have two sides! Upload photos of <strong>Card Front</strong> (finished dish photo, prep/cook time, ingredients) and <strong>Card Back</strong> (step-by-step cooking steps) to create a complete recipe.
			</p>
		</header>

		<div class="scanner-card">
			<form id="scanner-form" class="scanner-form">
				<!-- Dual Dropzone Row (Front & Back) -->
				<div class="dual-upload-row">
					<!-- Front Side Dropzone -->
					<div class="upload-box">
						<label class="box-label">📸 1. CARD FRONT (Photo & Ingredients)</label>
						<div class="upload-area" id="front-area">
							<input type="file" id="card_front_image" name="card_front_image" accept="image/*" capture="environment" class="file-input" />
							<div class="upload-prompt" id="front-prompt">
								<div class="upload-icon">🖼️</div>
								<h4>Snap Card Front</h4>
								<p>Dish photo, prep time & ingredients</p>
								<span class="upload-btn-fake">Take Photo / Choose</span>
							</div>
							<div class="image-preview" id="front-preview" hidden>
								<img id="front-preview-img" src="" alt="Front Card Preview" />
								<button type="button" id="remove-front-btn" class="remove-btn">Change Photo</button>
							</div>
						</div>
					</div>

					<!-- Back Side Dropzone -->
					<div class="upload-box">
						<label class="box-label">📋 2. CARD BACK (Cooking Instructions)</label>
						<div class="upload-area" id="back-area">
							<input type="file" id="card_back_image" name="card_back_image" accept="image/*" capture="environment" class="file-input" />
							<div class="upload-prompt" id="back-prompt">
								<div class="upload-icon">📝</div>
								<h4>Snap Card Back</h4>
								<p>Steps 1-6 & chef diagrams</p>
								<span class="upload-btn-fake">Take Photo / Choose</span>
							</div>
							<div class="image-preview" id="back-preview" hidden>
								<img id="back-preview-img" src="" alt="Back Card Preview" />
								<button type="button" id="remove-back-btn" class="remove-btn">Change Photo</button>
							</div>
						</div>
					</div>
				</div>

				<!-- Source & Equipment Configuration -->
				<div class="form-row">
					<div class="form-group">
						<label for="source" class="form-label">Recipe Source / Card Brand</label>
						<select id="source" name="source" class="form-select">
							<option value="HomeChef">HomeChef Meal Card</option>
							<option value="HelloFresh">HelloFresh Meal Card</option>
							<option value="Kamado Joe">Kamado Joe BBQ Special</option>
							<option value="Oklahoma Joe">Oklahoma Joe Smoker Special</option>
							<option value="Homemade Original">Homemade Original Recipe</option>
							<option value="Family Tradition">Family Tradition</option>
						</select>
					</div>

					<div class="form-group">
						<label for="equipment" class="form-label">Grill & Cooking Equipment</label>
						<select id="equipment" name="equipment" class="form-select">
							<option value="Kamado Joe Classic III">Kamado Joe Classic III (Ceramic)</option>
							<option value="Oklahoma Joe DLX 900">Oklahoma Joe DLX 900 (Pellet Smoker)</option>
							<option value="Kamado Joe Classic III w/ Joetisserie">Joetisserie Rotisserie (Kamado Joe)</option>
							<option value="Kamado Joe Classic III w/ DoJoe">DoJoe Wood-Fired Pizza Wedge</option>
							<option value="Cast Iron Dutch Oven">Cast Iron Dutch Oven</option>
							<option value="Indoor Oven & Stovetop Skillet">Indoor Oven & Stovetop Skillet</option>
						</select>
					</div>
				</div>

				<!-- Quick Metadata Fields -->
				<div class="form-group">
					<label for="title" class="form-label">Recipe Title</label>
					<input type="text" id="title" name="title" class="form-input" placeholder="e.g. HomeChef Garlic-Parmesan Crusted Chicken or Rotisserie Smoked Pork" />
				</div>

				<div class="form-row">
					<div class="form-group">
						<label for="prep_time" class="form-label">Prep Time</label>
						<input type="text" id="prep_time" name="prep_time" class="form-input" value="15 mins" />
					</div>
					<div class="form-group">
						<label for="cook_time" class="form-label">Cook Time</label>
						<input type="text" id="cook_time" name="cook_time" class="form-input" value="30 mins" />
					</div>
					<div class="form-group">
						<label for="servings" class="form-label">Yield / Servings</label>
						<input type="text" id="servings" name="servings" class="form-input" value="2-4 servings" />
					</div>
				</div>

				<div class="form-group">
					<label for="ingredients" class="form-label">Ingredients Checklist (From Front Card)</label>
					<textarea id="ingredients" name="ingredients" class="form-textarea" rows="4" placeholder="• 2 Boneless Chicken Breasts&#10;• 1/4 cup Panko Breadcrumbs&#10;• 3 tbsp Parmesan&#10;• 12 oz Yukon Gold Potatoes"></textarea>
				</div>

				<div class="form-group">
					<label for="instructions" class="form-label">Step-by-Step Instructions (From Back Card)</label>
					<textarea id="instructions" name="instructions" class="form-textarea" rows="6" placeholder="1. Prep & Season&#10;Wash vegetables and pat protein dry with paper towels.&#10;&#10;2. Sear & Roast&#10;Heat grill/oven to 400°F. Roast until golden brown."></textarea>
				</div>

				<button type="submit" id="submit-btn" class="submit-btn">
					<span>✨ Process Both Card Sides & Publish Recipe</span>
				</button>
			</form>
		</div>
	</div>
</Base>

<script>
	document.addEventListener("DOMContentLoaded", () => {
		// Front photo preview
		const frontInput = document.getElementById("card_front_image") as HTMLInputElement;
		const frontPrompt = document.getElementById("front-prompt");
		const frontPreview = document.getElementById("front-preview");
		const frontPreviewImg = document.getElementById("front-preview-img") as HTMLImageElement;
		const removeFrontBtn = document.getElementById("remove-front-btn");

		frontInput?.addEventListener("change", () => {
			const file = frontInput.files?.[0];
			if (file) {
				const reader = new FileReader();
				reader.onload = (e) => {
					if (frontPreviewImg && e.target?.result) {
						frontPreviewImg.src = e.target.result as string;
						frontPrompt?.setAttribute("hidden", "true");
						frontPreview?.removeAttribute("hidden");
					}
				};
				reader.readAsDataURL(file);
			}
		});

		removeFrontBtn?.addEventListener("click", (e) => {
			e.preventDefault();
			if (frontInput) frontInput.value = "";
			frontPrompt?.removeAttribute("hidden");
			frontPreview?.setAttribute("hidden", "true");
		});

		// Back photo preview
		const backInput = document.getElementById("card_back_image") as HTMLInputElement;
		const backPrompt = document.getElementById("back-prompt");
		const backPreview = document.getElementById("back-preview");
		const backPreviewImg = document.getElementById("back-preview-img") as HTMLImageElement;
		const removeBackBtn = document.getElementById("remove-back-btn");

		backInput?.addEventListener("change", () => {
			const file = backInput.files?.[0];
			if (file) {
				const reader = new FileReader();
				reader.onload = (e) => {
					if (backPreviewImg && e.target?.result) {
						backPreviewImg.src = e.target.result as string;
						backPrompt?.setAttribute("hidden", "true");
						backPreview?.removeAttribute("hidden");
					}
				};
				reader.readAsDataURL(file);
			}
		});

		removeBackBtn?.addEventListener("click", (e) => {
			e.preventDefault();
			if (backInput) backInput.value = "";
			backPrompt?.removeAttribute("hidden");
			backPreview?.setAttribute("hidden", "true");
		});

		// Submit form to API
		const form = document.getElementById("scanner-form") as HTMLFormElement;
		const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;

		form?.addEventListener("submit", async (e) => {
			e.preventDefault();
			submitBtn.disabled = true;
			submitBtn.innerText = "⏳ Extracting Both Card Sides & Publishing Recipe...";

			try {
				const formData = new FormData(form);
				const res = await fetch("/api/scan-recipe", {
					method: "POST",
					body: formData,
				});

				const data = await res.json();
				if (data.success && data.redirectUrl) {
					window.location.href = data.redirectUrl;
				} else {
					alert("Error: " + (data.error || "Failed to process card"));
					submitBtn.disabled = false;
					submitBtn.innerText = "✨ Process Both Card Sides & Publish Recipe";
				}
			} catch (err: any) {
				alert("Scan failed: " + err.message);
				submitBtn.disabled = false;
				submitBtn.innerText = "✨ Process Both Card Sides & Publish Recipe";
			}
		});
	});
</script>

<style>
	.scanner-page {
		max-width: 900px;
		margin: 0 auto;
		padding: 2.5rem 1.5rem 4rem 1.5rem;
	}
	.back-link {
		color: var(--color-brand, #0066cc);
		text-decoration: none;
		font-weight: 600;
		font-size: 0.875rem;
		display: inline-block;
		margin-bottom: 1rem;
	}
	.page-header {
		text-align: center;
		margin-bottom: 2.5rem;
	}
	.badge {
		background: rgba(0, 102, 204, 0.08);
		color: var(--color-brand, #0066cc);
		font-weight: 700;
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		padding: 0.35rem 0.85rem;
		border-radius: 20px;
		display: inline-block;
		margin-bottom: 0.75rem;
	}
	.page-title {
		font-size: 2.5rem;
		font-weight: 700;
		color: var(--color-text, #0f172a);
		margin: 0 0 0.75rem 0;
	}
	.page-description {
		font-size: 1.0625rem;
		color: var(--color-text-secondary, #475569);
		line-height: 1.6;
		margin: 0;
	}
	.scanner-card {
		background: var(--color-surface, #ffffff);
		border: 1px solid var(--color-border, #e2e8f0);
		border-radius: 16px;
		padding: 2rem;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
	}
	.dual-upload-row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.5rem;
		margin-bottom: 2rem;
	}
	@media (max-width: 680px) {
		.dual-upload-row {
			grid-template-columns: 1fr;
		}
	}
	.box-label {
		display: block;
		font-size: 0.875rem;
		font-weight: 700;
		color: var(--color-text, #0f172a);
		margin-bottom: 0.5rem;
	}
	.upload-area {
		border: 2px dashed var(--color-brand, #0066cc);
		background: rgba(0, 102, 204, 0.02);
		border-radius: 12px;
		padding: 2rem 1rem;
		text-align: center;
		position: relative;
		cursor: pointer;
		transition: background 0.2s ease;
		min-height: 200px;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.upload-area:hover {
		background: rgba(0, 102, 204, 0.05);
	}
	.file-input {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		opacity: 0;
		cursor: pointer;
	}
	.upload-icon {
		font-size: 2.5rem;
		margin-bottom: 0.4rem;
	}
	.upload-prompt h4 {
		margin: 0 0 0.25rem 0;
		font-size: 1.1rem;
		color: var(--color-text, #0f172a);
	}
	.upload-prompt p {
		margin: 0 0 0.85rem 0;
		font-size: 0.8125rem;
		color: var(--color-muted, #64748b);
	}
	.upload-btn-fake {
		display: inline-block;
		background: var(--color-brand, #0066cc);
		color: #ffffff;
		padding: 0.4rem 0.85rem;
		border-radius: 6px;
		font-weight: 600;
		font-size: 0.8125rem;
	}
	.image-preview img {
		max-height: 180px;
		border-radius: 8px;
		margin: 0 auto 0.75rem auto;
		display: block;
	}
	.remove-btn {
		background: #ef4444;
		color: #ffffff;
		border: none;
		border-radius: 6px;
		padding: 0.35rem 0.75rem;
		font-size: 0.75rem;
		font-weight: 600;
		cursor: pointer;
	}
	.form-row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.25rem;
	}
	@media (max-width: 600px) {
		.form-row {
			grid-template-columns: 1fr;
		}
	}
	.form-group {
		margin-bottom: 1.25rem;
	}
	.form-label {
		display: block;
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--color-text, #0f172a);
		margin-bottom: 0.4rem;
	}
	.form-input,
	.form-select,
	.form-textarea {
		width: 100%;
		padding: 0.75rem;
		border: 1px solid var(--color-border, #cbd5e1);
		border-radius: 8px;
		font-family: inherit;
		font-size: 0.9375rem;
		color: var(--color-text, #0f172a);
		background: var(--color-bg, #ffffff);
		box-sizing: border-box;
	}
	.form-input:focus,
	.form-select:focus,
	.form-textarea:focus {
		outline: none;
		border-color: var(--color-brand, #0066cc);
		box-shadow: 0 0 0 3px var(--color-brand-ring, rgba(0, 102, 204, 0.15));
	}
	.submit-btn {
		width: 100%;
		background: var(--color-brand, #0066cc);
		color: #ffffff;
		border: none;
		border-radius: 8px;
		padding: 1rem;
		font-size: 1.125rem;
		font-weight: 700;
		cursor: pointer;
		transition: background 0.2s ease, transform 0.1s ease;
		margin-top: 1rem;
	}
	.submit-btn:hover:not(:disabled) {
		background: var(--color-brand-hover, #0052a3);
		transform: translateY(-1px);
	}
	.submit-btn:disabled {
		background: var(--color-muted, #94a3b8);
		cursor: not-allowed;
	}
</style>
