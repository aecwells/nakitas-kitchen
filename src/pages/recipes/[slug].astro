---
import { getEmDashEntry, getEmDashCollection, getEntryTerms } from "emdash";
import { Image, PortableText, Comments } from "emdash/ui";
import Base from "../../layouts/Base.astro";

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/404");

const { entry: recipe, cacheHint } = await getEmDashEntry("recipes", slug);
if (!recipe) return Astro.redirect("/404");

Astro.cache.set(cacheHint);
const data = recipe.data;

// Retrieve taxonomy terms for categories, difficulty, dietary, and tags
const [categories, difficultyTerms, dietaryTerms, tags] = await Promise.all([
	getEntryTerms("recipes", data.id, "category").catch(() => []),
	getEntryTerms("recipes", data.id, "difficulty").catch(() => []),
	getEntryTerms("recipes", data.id, "dietary").catch(() => []),
	getEntryTerms("recipes", data.id, "tag").catch(() => []),
]);

// Check if there is a matching shop product
let matchingProduct = null;
try {
	const { entries: products } = await getEmDashCollection("products", { limit: 50 });
	matchingProduct = products?.find((p: any) => p.data?.matched_recipe_slug === slug);
} catch (e) {
	// ignore match error
}

const bylines = data.bylines ?? [];
const difficulty = difficultyTerms && difficultyTerms.length > 0 ? difficultyTerms[0].label : null;

// Baker's percentage calculations for sourdough/bread recipes
const isSourdough = slug.includes("sourdough") || (data.ingredients && data.ingredients.toLowerCase().includes("sourdough"));
// Visual Ingredient Icon Resolver
function getIngredientIcon(text: string) {
	const t = text.toLowerCase();
	if (t.includes("chicken") || t.includes("meat") || t.includes("steak") || t.includes("pork") || t.includes("poultry")) return "🍗";
	if (t.includes("carrot")) return "🥕";
	if (t.includes("onion")) return "🧅";
	if (t.includes("garlic")) return "🧄";
	if (t.includes("thyme") || t.includes("rosemary") || t.includes("herb")) return "🌿";
	if (t.includes("flour") || t.includes("bread") || t.includes("yeast")) return "🌾";
	if (t.includes("cheese") || t.includes("cream cheese") || t.includes("mozzarella")) return "🧀";
	if (t.includes("butter")) return "🧈";
	if (t.includes("lemon")) return "🍋";
	if (t.includes("potato")) return "🥔";
	if (t.includes("biscuit") || t.includes("bun")) return "🥖";
	if (t.includes("stock") || t.includes("broth") || t.includes("sauce")) return "🥣";
	if (t.includes("celery")) return "🥬";
	if (t.includes("pepper") || t.includes("spice") || t.includes("salt")) return "🧂";
	if (t.includes("oil") || t.includes("olive")) return "🫒";
	if (t.includes("milk") || t.includes("cream")) return "🥛";
	if (t.includes("egg")) return "🥚";
	return "▫️";
}

// Check if user is logged in or previewing
const sessionCookie = Astro.cookies.get("emdash_session")?.value;
const urlPreview = Astro.url.searchParams.get("preview");
const isLoggedIn = Boolean(sessionCookie || urlPreview === "1" || (Astro.locals as any)?.user);

// Universal Uniform Step Parser: Splits raw text, JSON arrays, or blocks into distinct uniform Step objects (1..N)
let rawText = "";
if (typeof data.content === "string") {
	try {
		const parsed = JSON.parse(data.content);
		if (Array.isArray(parsed)) {
			parsed.forEach((b: any) => {
				const bText = b.children?.map((c: any) => c.text).join("") || "";
				rawText += bText + "\n";
			});
		} else {
			rawText = data.content;
		}
	} catch (e) {
		rawText = data.content;
	}
} else if (Array.isArray(data.content)) {
	data.content.forEach((b: any) => {
		const bText = b.children?.map((c: any) => c.text).join("") || "";
		rawText += bText + "\n";
	});
}

function extractUniformSteps(text: string) {
	const steps: { number: number; title: string; text: string }[] = [];
	if (!text || !text.trim()) return steps;

	// Regex matching step numbers like "1. Prep Ingredients", "2. Cook Chicken", "3. Cook Veggies", "Step 4: Make Filling"
	const stepHeaderRegex = /(?:^|\n)\s*(?:Step\s*)?(\d+)[\.:\s]+([^\n]+)/gi;
	const matches: { index: number; number: number; title: string; headerLength: number }[] = [];
	let match;

	while ((match = stepHeaderRegex.exec(text)) !== null) {
		matches.push({
			index: match.index,
			number: parseInt(match[1], 10),
			title: match[2].trim(),
			headerLength: match[0].length,
		});
	}

	if (matches.length > 0) {
		for (let i = 0; i < matches.length; i++) {
			const current = matches[i];
			const nextIndex = i + 1 < matches.length ? matches[i + 1].index : text.length;
			const stepContent = text.substring(current.index + current.headerLength, nextIndex).trim();

			steps.push({
				number: current.number || i + 1,
				title: current.title,
				text: stepContent || current.title,
			});
		}
	} else {
		const paragraphs = text.split(/\n\s*\n/).filter((p) => p.trim());
		paragraphs.forEach((p, idx) => {
			const lines = p.trim().split("\n");
			const firstLine = lines[0].trim();
			const bodyText = lines.slice(1).join("\n").trim() || firstLine;
			steps.push({
				number: idx + 1,
				title: lines.length > 1 ? firstLine : `Step ${idx + 1}`,
				text: bodyText,
			});
		});
	}

	return steps;
}

const recipeSteps = extractUniformSteps(rawText);
---

<Base
	title={`${data.title} | Nakita's Kitchen`}
	description={data.excerpt || data.title}
	image={data.featured_image?.src}
	type="article"
	content={{ collection: "recipes", id: data.id, slug: recipe.id }}
>
	<article class="recipe-detail-page">
		<header class="recipe-header container">
			<div class="header-nav-row">
				<a href="/recipes" class="back-link">&larr; Back to Recipes</a>
				{categories && categories.length > 0 && (
					<div class="category-chips">
						{categories.map((cat: any) => (
							<span class="cat-chip">{cat.label}</span>
						))}
					</div>
				)}
			</div>

			<h1 class="recipe-title">{data.title}</h1>

			<div class="meta-bar">
				{bylines.length > 0 && (
					<div class="byline-row">
						<span class="byline-prefix">Recipe by</span>
						{bylines.map((credit: any) => (
							<span class="byline-author">
								{credit.byline.displayName || "Nakita"}
							</span>
						))}
					</div>
				)}

				{data.recipe_source && (
					<span class="source-badge-meta">
						📌 Source: {data.recipe_source}
					</span>
				)}

				{difficulty && (
					<span class="difficulty-badge">
						⚡ Difficulty: {difficulty}
					</span>
				)}

				<button type="button" class="print-btn" onclick="window.print()">
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<polyline points="6 9 6 2 18 2 18 9"></polyline>
						<path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
						<rect x="6" y="14" width="12" height="8"></rect>
					</svg>
					<span>Print Recipe</span>
				</button>
			</div>

			{data.equipment && (
				<div class="equipment-banner">
					<span class="equip-icon">⚙️</span>
					<span>Recommended Equipment: <strong>{data.equipment}</strong></span>
				</div>
			)}

			{data.excerpt && <p class="recipe-excerpt">{data.excerpt}</p>}

			<div class="recipe-specs-card">
				{data.prep_time && (
					<div class="spec-item">
						<span class="spec-label">Prep Time</span>
						<span class="spec-value">{data.prep_time}</span>
					</div>
				)}
				{data.cook_time && (
					<div class="spec-item">
						<span class="spec-label">Cook Time</span>
						<span class="spec-value">{data.cook_time}</span>
					</div>
				)}
				{data.servings && (
					<div class="spec-item">
						<span class="spec-label">Yield / Servings</span>
						<span class="spec-value">{data.servings}</span>
					</div>
				)}
				{isSourdough && (
					<div class="spec-item baker-math">
						<span class="spec-label">Baker's Math</span>
						<span class="spec-value highlight">75% Hydration • 20% Starter • 2% Salt</span>
					</div>
				)}
			</div>
		</header>

		{data.featured_image && (
			<div class="hero-image-container container">
				<Image image={data.featured_image} alt={data.title} />
			</div>
		)}

		<div class="recipe-layout container">
			<aside class="recipe-ingredients-sidebar">
				<div class="ingredients-box">
					<div class="ingredients-header">
						<h3 class="ingredients-title">Ingredients</h3>
					</div>

					<!-- Interactive Unit & Scale Controls -->
					<div class="measurement-toolbar">
						<div class="unit-toggle-group">
							<button type="button" class="unit-btn active" id="unit-metric">⚖️ Metric (g/ml)</button>
							<button type="button" class="unit-btn" id="unit-imperial">🥣 US (oz/cups)</button>
						</div>

						<div class="scaler-controls">
							<span class="scaler-label">Batch:</span>
							<button type="button" class="scale-btn active" data-scale="1">1x</button>
							<button type="button" class="scale-btn" data-scale="2">2x</button>
							<button type="button" class="scale-btn" data-scale="3">3x</button>
						</div>
					</div>

					{data.ingredients ? (
						<ul class="ingredients-list" id="ingredients-list">
							{data.ingredients.split("\n").filter(Boolean).map((ing: string) => {
								const cleanIng = ing.replace(/^•\s*/, "");
								const icon = getIngredientIcon(cleanIng);
								return (
									<li class="ingredient-item">
										<label class="checkbox-label">
											<input type="checkbox" />
											<span class="ing-icon-badge">{icon}</span>
											<span class="ingredient-text" data-raw-text={cleanIng}>
												{cleanIng}
											</span>
										</label>
									</li>
								);
							})}
						</ul>
					) : (
						<p>No ingredients listed.</p>
					)}

					{data.allergens && (
						<div class="allergen-box">
							<strong>Allergens:</strong> {data.allergens}
						</div>
					)}

					{dietaryTerms && dietaryTerms.length > 0 && (
						<div class="dietary-box">
							<strong>Dietary:</strong>
							<div class="dietary-list">
								{dietaryTerms.map((diet: any) => (
									<span class="diet-chip">✓ {diet.label}</span>
								))}
							</div>
						</div>
					)}

					{tags && tags.length > 0 && (
						<div class="tags-container">
							<span class="tags-heading">Tags:</span>
							<div class="tags-list">
								{tags.map((tag: any) => (
									<span class="tag-chip">#{tag.label}</span>
								))}
							</div>
						</div>
					)}

					{matchingProduct && (
						<div class="shop-match-box">
							<h4>Available for Pre-Order!</h4>
							<p>Don't want to bake it yourself? Order freshly baked {matchingProduct.data.title} directly from our cottage bakery.</p>
							<a href={`/shop/${matchingProduct.id}`} class="buy-link">Order Pre-Order (${matchingProduct.data.price}) &rarr;</a>
						</div>
					)}
				</div>
			</aside>

			<main class="recipe-body">
				<h2 class="section-heading">Step-by-Step Cooking Instructions</h2>

				{recipeSteps.length > 0 ? (
					<div class="cooking-steps-container">
						{recipeSteps.map((step) => (
							<div class="step-card">
								<div class="step-number-badge">
									<span>{step.number}</span>
								</div>
								<div class="step-details">
									<h3 class="step-title">{step.title}</h3>
									<p class="step-text">{step.text}</p>
								</div>
							</div>
						))}
					</div>
				) : data.content ? (
					<div class="portable-content">
						<PortableText content={Array.isArray(parsedContent) ? parsedContent : []} />
					</div>
				) : (
					<p class="empty-notice">No instructions available for this recipe.</p>
				)}

				{data.card_scan_image && (
					<section class="scanned-card-inspection">
						<h3 class="scanned-card-heading">📷 Original Scanned Recipe Cards (Front & Back)</h3>
						<div class="scanned-cards-grid">
							{data.featured_image && (
								<div class="scanned-card-item">
									<span class="card-side-label">Card Front</span>
									<Image image={data.featured_image} alt={`${data.title} Front Card Photo`} />
								</div>
							)}
							{data.card_scan_image && (
								<div class="scanned-card-item">
									<span class="card-side-label">Card Back</span>
									<Image image={data.card_scan_image} alt={`${data.title} Back Card Photo`} />
								</div>
							)}
						</div>
					</section>
				)}

				{data.cottage_license_notice && (
					<footer class="recipe-footer-notice">
						<p><em>{data.cottage_license_notice}</em></p>
					</footer>
				)}

				<!-- Nakita's Kitchen Owner Chef Notes & Cooking Tips -->
				<section class="chef-notes-section">
					<h3 class="chef-notes-heading">👨‍🍳 Nakita's Kitchen Chef & Pitmaster Notes</h3>
					<div class="chef-notes-card">
						<p>
							<em>"For the best result with this {data.recipe_source || 'custom'} recipe, make sure to prep and pre-portion all ingredients before starting heat. If cooking on the Kamado Joe Classic III or Oklahoma Joe DLX 900 pellet smoker, hold your cooking temperature at 425°F indirect for an authentic wood-fired flavor profile!"</em>
						</p>
						<span class="chef-signature">— Nakita's Kitchen Culinary Team</span>
					</div>
				</section>
			</main>
		</div>
	</article>
</Base>

<script>
	// Interactive Unit Converter (Metric vs US Imperial) and Batch Scaler
	document.addEventListener("DOMContentLoaded", () => {
		const scaleBtns = document.querySelectorAll<HTMLButtonElement>(".scale-btn");
		const unitMetricBtn = document.getElementById("unit-metric");
		const unitImperialBtn = document.getElementById("unit-imperial");
		const ingredientElements = document.querySelectorAll<HTMLElement>(".ingredient-text");

		let currentScale = 1;
		let currentUnitSystem: "metric" | "imperial" = "metric";

		function updateIngredients() {
			ingredientElements.forEach((el) => {
				const raw = el.dataset.rawText || el.innerText;

				if (currentUnitSystem === "imperial") {
					// Convert grams (g) to ounces (oz) and milliliters (ml) to fl oz
					let converted = raw.replace(/(\d+(?:\.\d+)?)\s*g\b/gi, (_, g) => {
						const oz = (parseFloat(g) * 0.035274 * currentScale).toFixed(1);
						return `${oz} oz`;
					}).replace(/(\d+(?:\.\d+)?)\s*ml\b/gi, (_, ml) => {
						const flOz = (parseFloat(ml) * 0.033814 * currentScale).toFixed(1);
						return `${flOz} fl oz`;
					});

					if (converted === raw) {
						// Scale plain numbers if no g/ml unit match
						converted = raw.replace(/(\d+(?:\.\d+)?)/g, (_, num) => {
							return (parseFloat(num) * currentScale).toString();
						});
					}
					el.innerText = converted;
				} else {
					// Metric mode with scaling
					const scaled = raw.replace(/(\d+(?:\.\d+)?)/g, (_, num) => {
						return (parseFloat(num) * currentScale).toString();
					});
					el.innerText = scaled;
				}
			});
		}

		scaleBtns.forEach((btn) => {
			btn.addEventListener("click", () => {
				currentScale = parseFloat(btn.dataset.scale || "1");
				scaleBtns.forEach((b) => b.classList.remove("active"));
				btn.classList.add("active");
				updateIngredients();
			});
		});

		unitMetricBtn?.addEventListener("click", () => {
			currentUnitSystem = "metric";
			unitMetricBtn.classList.add("active");
			unitImperialBtn?.classList.remove("active");
			updateIngredients();
		});

		unitImperialBtn?.addEventListener("click", () => {
			currentUnitSystem = "imperial";
			unitImperialBtn.classList.add("active");
			unitMetricBtn?.classList.remove("active");
			updateIngredients();
		});
	});
</script>

<style>
