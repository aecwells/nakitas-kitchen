---
import { getEmDashCollection, getTermsForEntries } from "emdash";
import Base from "../../layouts/Base.astro";
import { getReadingTime } from "../../utils/reading-time";

const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const tagsByEntry = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"tag",
);

const postsWithTags = posts.map((post) => ({
	post,
	tags: tagsByEntry.get(post.data.id) ?? [],
	bylines: post.data.bylines ?? [],
}));

const formatDate = (date: Date) =>
	date.toLocaleDateString("en-US", {
		year: "numeric",
		month: "long",
		day: "numeric",
	});
---

<Base title="All Posts" description="Browse all blog posts">
	<div class="posts-page">
		<header class="page-header">
			<h1 class="page-title">All Posts & Articles</h1>
			<p class="page-description">
				{posts.length}
				{posts.length === 1 ? "article" : "articles"} on sourdough baking, outdoor cooking, tech, and craft.
			</p>
		</header>

		<!-- Interactive Article Tag Filter Chips -->
		<div class="filter-bar">
			<div class="chips-row">
				<button type="button" class="post-filter-chip active" data-filter="all">All Articles</button>
				<button type="button" class="post-filter-chip" data-filter="development">Development</button>
				<button type="button" class="post-filter-chip" data-filter="design">Design</button>
				<button type="button" class="post-filter-chip" data-filter="tools">Tools</button>
				<button type="button" class="post-filter-chip" data-filter="sourdough">Sourdough</button>
				<button type="button" class="post-filter-chip" data-filter="opinion">Opinion</button>
			</div>
		</div>

		{
			posts.length === 0 ? (
				<p class="empty">No posts yet.</p>
			) : (
				<div class="posts-list" id="posts-list">
					{postsWithTags.map(({ post, tags, bylines }) => (
						<article class="post-item" data-tags={tags.map(t => t.slug).join(",")} data-title={post.data.title.toLowerCase()}>
							<a href={`/posts/${post.id}`} class="post-link">
								<div class="post-meta">
									{bylines.length > 0 && (
										<>
											<div class="post-bylines">
												{bylines.slice(0, 2).map((credit, index) => (
													<>
														{index > 0 && <span class="byline-sep">,</span>}
														<span class="post-byline">
															{credit.byline.avatarMediaId && (
																<img
																	src={`/_emdash/api/media/file/${credit.byline.avatarMediaId}`}
																	alt={credit.byline.displayName}
																	class="post-byline-avatar"
																/>
															)}
															<span class="post-byline-name">
																{credit.byline.displayName}
															</span>
														</span>
													</>
												))}
												{bylines.length > 2 && (
													<span class="byline-more">+{bylines.length - 2}</span>
												)}
											</div>
											<span class="meta-dot" />
										</>
									)}
									{post.data.publishedAt && (
										<time>{formatDate(post.data.publishedAt)}</time>
									)}
									{post.data.publishedAt && <span class="meta-dot" />}
									<span>{getReadingTime(post.data.content)} min read</span>
								</div>
								<h2 class="post-title">{post.data.title}</h2>
								{post.data.excerpt && (
									<p class="post-excerpt">{post.data.excerpt}</p>
								)}
							</a>
							{tags.length > 0 && (
								<div class="post-tags">
									{tags.slice(0, 3).map((t) => (
										<a href={`/tag/${t.slug}`} class="post-tag">
											{t.label}
										</a>
									))}
								</div>
							)}
						</article>
					))}
				</div>
			)
		}
	</div>
</Base>

<script>
	document.addEventListener("DOMContentLoaded", () => {
		const chips = document.querySelectorAll(".post-filter-chip");
		const items = document.querySelectorAll(".post-item");

		chips.forEach((chip) => {
			chip.addEventListener("click", () => {
				chips.forEach((c) => c.classList.remove("active"));
				chip.classList.add("active");

				const filter = chip.getAttribute("data-filter");
				items.forEach((item) => {
					const el = item as HTMLElement;
					const tags = (el.getAttribute("data-tags") || "").toLowerCase();
					const title = (el.getAttribute("data-title") || "").toLowerCase();

					if (filter === "all") {
						el.style.display = "";
					} else if (tags.includes(filter || "") || title.includes(filter || "")) {
						el.style.display = "";
					} else {
						el.style.display = "none";
					}
				});
			});
		});
	});
</script>

<style>
	.posts-page {
		max-width: var(--content-width);
		margin: 0 auto;
		padding: var(--spacing-8) var(--spacing-6) var(--spacing-16);
	}

	.page-header {
		margin-bottom: var(--spacing-6);
		text-align: center;
	}

	.page-title {
		font-size: var(--font-size-3xl);
		font-weight: var(--font-weight-display);
		letter-spacing: var(--tracking-tight);
		color: var(--color-text);
		margin-bottom: var(--spacing-2);
	}

	.page-description {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
	}

	.filter-bar {
		display: flex;
		justify-content: center;
		margin-bottom: var(--spacing-8);
	}

	.chips-row {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
		justify-content: center;
	}

	.post-filter-chip {
		background: var(--color-bg-subtle, #f1f5f9);
		border: 1px solid var(--color-border, #cbd5e1);
		color: var(--color-text, #0f172a);
		padding: 0.35rem 0.85rem;
		border-radius: 20px;
		font-size: 0.8125rem;
		font-weight: 600;
		cursor: pointer;
		transition: all 0.15s ease;
	}

	.post-filter-chip:hover {
		border-color: var(--color-brand, #0066cc);
		color: var(--color-brand, #0066cc);
	}

	.post-filter-chip.active {
		background: var(--color-brand, #0066cc);
		color: #ffffff;
		border-color: var(--color-brand, #0066cc);
	}

	.empty {
		color: var(--color-muted);
		font-size: var(--font-size-sm);
		text-align: center;
		padding: var(--spacing-12) 0;
	}

	.posts-list {
		display: flex;
		flex-direction: column;
	}

	.post-item {
		padding: var(--spacing-8) 0;
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.post-item:last-child {
		border-bottom: none;
	}

	.post-link {
		text-decoration: none;
		display: block;
	}

	.post-meta {
		display: flex;
		align-items: center;
		gap: var(--spacing-2);
		font-size: var(--font-size-xs);
		color: var(--color-muted);
		margin-bottom: var(--spacing-2);
	}

	.post-bylines {
		display: flex;
		align-items: center;
		gap: var(--spacing-1);
	}

	.post-byline {
		display: flex;
		align-items: center;
		gap: var(--spacing-1-5);
	}

	.post-byline-avatar {
		width: var(--avatar-size-xs);
		height: var(--avatar-size-xs);
		border-radius: var(--radius-full);
		object-fit: cover;
	}

	.post-byline-name {
		font-weight: 500;
		color: var(--color-text-secondary);
	}

	.byline-sep {
		color: var(--color-muted);
	}

	.byline-more {
		font-weight: 500;
		color: var(--color-muted);
	}

	.meta-dot {
		display: inline-block;
		width: 3px;
		height: 3px;
		border-radius: var(--radius-full);
		background-color: var(--color-muted);
	}

	.post-title {
		font-size: var(--font-size-xl);
		font-weight: var(--font-weight-heading);
		color: var(--color-text);
		margin-bottom: var(--spacing-2);
		transition: color var(--transition-fast);
	}

	.post-link:hover .post-title {
		color: var(--color-brand);
	}

	.post-excerpt {
		font-size: var(--font-size-sm);
		color: var(--color-text-secondary);
		line-height: var(--leading-relaxed);
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.post-tags {
		display: flex;
		gap: var(--spacing-2);
		margin-top: var(--spacing-3);
	}

	.post-tag {
		font-size: var(--font-size-xs);
		color: var(--color-brand);
		background: var(--color-bg-subtle);
		padding: 0.15rem 0.5rem;
		border-radius: 12px;
		text-decoration: none;
		font-weight: 600;
	}
</style>
