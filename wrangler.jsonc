{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "nakitas-kitchen",
	"account_id": "6dc10b9b2d4dcffe1f9a15738392f263",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "ac1037c8155c491c80706bcc5f5500f0"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "nakitas-kitchen-db",
			"database_id": "ec6c9e66-bfbc-4bee-8b3f-f33cd1621663"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "nakitas-kitchen-media"
		}
	],
	"send_email": [
		{
			"name": "EMAIL"
		}
	],
	// Drives scheduled publishing, plugin cron, and maintenance (see src/worker.ts)
	"triggers": {
		"crons": [
			"* * * * *"
		]
	}
}