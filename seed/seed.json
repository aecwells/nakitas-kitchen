		"posts": [
			{
				"id": "post-1",
				"slug": "welcome-to-nakitas-kitchen",
				"status": "published",
				"data": {
					"title": "Welcome to Nakita's Kitchen",
					"excerpt": "Exploring the magic of wild yeast, slow fermentation, and seasonal baking from our cottage kitchen.",
